[Unit]
Description=Rush Linux optimization daemon (apply mode)
Documentation=man:optid(8)
ConditionPathExists=/proc/pressure/cpu
Conflicts=tlp.service power-profiles-daemon.service tuned.service
Requires=optid-recover.service
After=multi-user.target systemd-udevd.service optid-recover.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=10s
TimeoutStartSec=30s
ExecStart=/usr/libexec/optid --apply --interval-sec 2 --state-dir /run/optid
Restart=on-failure
RestartForceExitStatus=75
RestartSec=2
StateDirectory=optid
RuntimeDirectory=optid

# SECURITY (audit finding #8): drop CAP_SYS_ADMIN per ADR 0009.
# The daemon writes to cgroupfs files (cpu.weight, cgroup.procs) under
# /sys/fs/cgroup/ — these are governed by filesystem permissions, not by
# CAP_SYS_ADMIN. The other writes (sysfs, procfs, /dev/cpu_dma_latency)
# are also governed by the ReadWritePaths below + file permissions.
# CAP_SYS_NICE is needed for sched_setattr/sched_setscheduler on real-time
# mode. CAP_SYS_RESOURCE is needed to raise RLIMIT_NOFILE above the
# default soft limit when polling many sysfs files.
# If a future actuator needs a capability not listed here, add it with a
# comment explaining the specific syscall/path it enables.
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_RESOURCE

# Core isolation
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices=no is required because the daemon opens /dev/cpu_dma_latency
# (a character device) to prevent C-states deeper than a configured threshold.
# Setting PrivateDevices=yes would hide /dev entirely and break that actuator.
PrivateDevices=no

# ProtectKernelTunables makes /sys, /proc/sys, etc. read-only. Without it,
# the entire /sys tree is writable regardless of ReadWritePaths, which
# defeats the sandbox. With it, ReadWritePaths becomes the actual gate.
ProtectKernelTunables=yes

# ReadWritePaths: statically-known system knobs + the dynamic-device
# subtrees that depth-enablers (runtime PM, PCIe ASPM, SATA ALPM,
# backlight, PM QoS resume latency) write to. Per-file granularity is
# enforced by the software allowlist in kernel_io.rs
# (is_allowlisted_write_path), which validates path SHAPE — not by
# systemd, which can only grant path PREFIXES.
ReadWritePaths=/run/optid \
    /sys/devices/system/cpu \
    /sys/firmware/acpi/platform_profile \
    /sys/devices \
    /sys/bus/pci \
    /sys/bus/usb \
    /sys/class/backlight \
    /sys/class/scsi_host \
    /proc/sys/vm \
    /dev/cpu_dma_latency

# Network: the daemon does not need network access. AF_UNIX is needed for
# D-Bus (system bus socket). AF_NETLINK is needed for reading netlink
# uevents (used by some actuators to detect device hotplug).
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

# SECURITY (audit finding #8): add the ADR-0009-recommended hardening
# directives. Each was validated against the daemon's real syscall/cgroup
# needs. If CI surfaces a regression, the failing directive should be
# documented here with the specific syscall it blocks, not removed silently.
# @system-service allows the common service calls; deny @privileged and
# @obsolete to block privesc vectors.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete
# Prevent the daemon from loading kernel modules or tampering with the
# kernel log ring buffer.
ProtectKernelModules=yes
ProtectKernelLogs=yes
# Prevent namespace creation (containers, mount namespaces, etc.) which
# could be used to escape the sandbox.
RestrictNamespaces=yes
# Lock the process personality (prevents switching to a different ABI).
LockPersonality=yes
# Prevent the daemon from creating writable executable memory (W^X).
# optid is Rust with no JIT, so this is safe.
MemoryDenyWriteExecute=yes
# Block real-time scheduling abuse (CAP_SYS_NICE is still needed for the
# legit real-time mode, but this blocks SCHED_FIFO/SCHED_RR from being
# set on arbitrary threads without going through the policy gate).
RestrictRealtime=yes
# Block setuid/setgid binary execution.
RestrictSUIDSGID=yes
# Clean up IPC objects owned by the daemon's user when it exits.
RemoveIPC=yes
# Only show processes owned by the same user in /proc (reduces info leak).
ProcSubset=pid
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
