[D-BUS Service]
# SECURITY (audit finding #7): the Name must match the bus name the daemon
# actually acquires (io.rushlinux.Optid, set in crates/optid/src/main.rs),
# NOT the interface name (io.rushlinux.Optid1). D-Bus activation routes
# requests for this well-known name to this Exec; a mismatch causes
# activation to fail silently and clients time out.
Name=io.rushlinux.Optid
Exec=/usr/libexec/optid --apply --interval-sec 2 --state-dir /run/optid
SystemdService=optid.service

