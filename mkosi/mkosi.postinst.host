#!/usr/bin/env bash
# mkosi.postinst.host — Post-install script executed on the host.
set -euo pipefail

echo "=== Rush Linux postinst (host) ==="
echo "  DESTDIR: ${DESTDIR}"

# 1. Remove password lock for root user
sed -i 's|^root:[^:]*:|root::|' "${DESTDIR}/etc/shadow"

# 2. Enable systemd services using offline enablement
systemctl --root="${DESTDIR}" enable systemd-networkd.service
systemctl --root="${DESTDIR}" enable systemd-resolved.service
systemctl --root="${DESTDIR}" enable systemd-oomd.service
systemctl --root="${DESTDIR}" enable optid.service
systemctl --root="${DESTDIR}" enable optid-boot-assess.service
systemctl --root="${DESTDIR}" mask systemd-firstboot.service

echo "=== postinst (host) complete ==="

