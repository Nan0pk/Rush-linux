# ─── Data types ──────────────────────────────────────────────────────────────


@dataclass
class HardwareState:
    """Detected hardware state from real or fake sysfs."""

    battery_present: bool = False
    battery_capacity_pct: int | None = None
    battery_status: str = "unknown"  # Charging/Discharging/Full/unknown
    battery_design_uwh: int = 0
    ac_online: bool | None = None
    platform_profile_available: bool = False
    platform_profile_choices: list[str] = field(default_factory=list)
    cpufreq_driver: str = "unknown"
    epp_available: bool = False
    epp_values: list[str] = field(default_factory=list)
    rapl_available: bool = False
    rapl_domain: str = ""
    cpu_model: str = "unknown"
    ncpu: int = 0
    dmi_board: str = "unknown"
    kernel: str = "unknown"

    def slot(self) -> tuple[str, str, list[str]]:
        """Infer the machine slot. Returns (slot, confidence, ambiguities)."""
        ambiguities: list[str] = []
        if self.battery_present:
            # Battery present → likely laptop.
            slot = "laptop"
            confidence = "high"
        elif self.battery_design_uwh == 0 and self.ac_online is True:
            # No battery + AC online → likely desktop.
            slot = "desktop"
            confidence = "high"
        elif self.ncpu >= 16 and not self.battery_present:
            # Many cores, no battery → likely server or high-end desktop.
            slot = "server"
            confidence = "medium"
            ambiguities.append(
                f"no battery + {self.ncpu} CPUs → could be server or desktop; "
                f"chose 'server' as safe default"
            )
        else:
            slot = "ambiguous"
            confidence = "low"
            ambiguities.append(
                f"cannot determine slot: battery_present={self.battery_present}, "
                f"ac_online={self.ac_online}, ncpu={self.ncpu}"
            )
        return (slot, confidence, ambiguities)


@dataclass
class Criterion:
    """An open exit criterion from milestones.toml."""

    milestone: str
    criterion: str
    verified: bool
    transcript: str
    note: str
    is_hardware_gated: bool = False
    requires_slot: str = ""  # "laptop", "desktop", or "" (both)


@dataclass
class PlanStep:
    """One step in a Plan."""

    seq: int
    kind: str  # "command" | "physical-prompt" | "validation"
    default: str  # "proceed" | "skip" | "ask" | "abort" | "wait"
    reason: str
    rollback: str
    # Optional fields depending on kind:
    argv: list[str] | None = None
    action: str | None = None
    detection_signal: str | None = None
    timeout: str | None = None
    validator: str | None = None
    bundle: str | None = None

    def to_dict(self) -> dict:
        d = asdict(self)
        # Drop None values for cleaner output.
        return {k: v for k, v in d.items() if v is not None}


@dataclass
class Plan:
    """The full plan produced by the planner."""

    schema_version: int = 1
    plan_kind: str = "rush-autopilot-plan"
    generated_at: str = ""
    source_version: str = ""
    source_commit: str = ""
    repo_root: str = ""
    hardware_slot: str = ""
    slot_confidence: str = ""
    ambiguities: list[str] = field(default_factory=list)
    open_criteria: list[dict] = field(default_factory=list)
    existing_evidence: list[str] = field(default_factory=list)
    steps: list[PlanStep] = field(default_factory=list)
    dry_run: bool = False

    def to_dict(self) -> dict:
        d = asdict(self)
        d["steps"] = [s.to_dict() for s in self.steps]
        return d


# ─── Hardware detection ──────────────────────────────────────────────────────


def _read_file(path: Path) -> str | None:
    """Read a file, return stripped content or None if missing/unreadable."""
    try:
        return path.read_text().strip()
    except (OSError, IOError):
        return None


def detect_hardware(sys_root: Path | None = None) -> HardwareState:
    """Detect hardware state from real sysfs or a fake sysfs root.

    Args:
        sys_root: If None, read from real /sys and /proc. If a Path, read
                  from <sys_root>/sys/ and <sys_root>/proc/ instead (for tests).
    """
    if sys_root is None:
        sys_base = Path("/sys")
        proc_base = Path("/proc")
    else:
        sys_base = sys_root / "sys"
        proc_base = sys_root / "proc"

    hw = HardwareState()

    # Battery detection.
    for bat_name in ("BAT0", "BAT1", "BATT"):
        bat_dir = sys_base / "class" / "power_supply" / bat_name
        if bat_dir.is_dir():
            hw.battery_present = True
            status = _read_file(bat_dir / "status")
            if status:
                hw.battery_status = status
            cap = _read_file(bat_dir / "capacity")
            if cap:
                try:
                    hw.battery_capacity_pct = int(cap)
                except ValueError:
                    pass
            design = _read_file(bat_dir / "energy_full_design")
            if design:
                try:
                    hw.battery_design_uwh = int(design)
                except ValueError:
                    pass
            break

    # AC detection.
    for ac_name in ("AC", "AC0", "ACAD", "ADP1"):
        ac_online_path = sys_base / "class" / "power_supply" / ac_name / "online"
        online = _read_file(ac_online_path)
        if online is not None:
            hw.ac_online = online == "1"
            break

    # platform_profile.
    pp_path = sys_base / "firmware" / "acpi" / "platform_profile"
    hw.platform_profile_available = pp_path.exists()
    choices = _read_file(sys_base / "firmware" / "acpi" / "platform_profile_choices")
    if choices:
        hw.platform_profile_choices = [c.strip() for c in choices.split() if c.strip()]

    # cpufreq driver.
    driver = _read_file(sys_base / "devices" / "system" / "cpu" / "cpu0" / "cpufreq" / "scaling_driver")
    if driver:
        hw.cpufreq_driver = driver

    # EPP availability.
    epp_path = sys_base / "devices" / "system" / "cpu" / "cpu0" / "cpufreq" / "energy_performance_preference"
    hw.epp_available = epp_path.exists()
    epp_vals = _read_file(sys_base / "devices" / "system" / "cpu" / "cpu0" / "cpufreq" / "energy_performance_available_preferences")
    if epp_vals:
        hw.epp_values = [v.strip() for v in epp_vals.split() if v.strip()]

    # RAPL.
    rapl_dir = sys_base / "class" / "powercap" / "intel-rapl:0"
    if rapl_dir.is_dir():
        hw.rapl_available = True
        hw.rapl_domain = str(rapl_dir)

    # CPU model + topology.
    cpuinfo = proc_base / "cpuinfo"
    if cpuinfo.exists():
        try:
            text = cpuinfo.read_text()
            for line in text.splitlines():
                if line.startswith("model name"):
                    hw.cpu_model = line.split(":", 1)[1].strip()
                    break
            hw.ncpu = text.count("processor\t:")
            if hw.ncpu == 0:
                hw.ncpu = text.count("\nprocessor")
        except OSError:
            pass

    # DMI board.
    vendor = _read_file(sys_base / "class" / "dmi" / "id" / "board_vendor") or ""
    name = _read_file(sys_base / "class" / "dmi" / "id" / "board_name") or ""
    if vendor or name:
        hw.dmi_board = f"{vendor} {name}".strip()
    else:
        hw.dmi_board = "unknown"

    # Kernel.
    if sys_root is None:
        hw.kernel = platform.release()
    else:
        # For fake sysfs, the kernel comes from the fake proc.
        uname = _read_file(proc_base / "sys" / "kernel" / "osrelease")
        if uname:
            hw.kernel = uname
        else:
            hw.kernel = "fake-kernel"

    return hw


# ─── Repo state reading ──────────────────────────────────────────────────────


def read_version(repo_root: Path) -> str:
    """Read the VERSION file."""
    v = _read_file(repo_root / "VERSION")
    return v or "unknown"


def read_git_commit(repo_root: Path) -> str:
    """Read the current git HEAD commit SHA."""
    try:
        r = subprocess.run(
            ["git", "-C", str(repo_root), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if r.returncode == 0:
            return r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return "unknown"


def read_milestones(repo_root: Path) -> dict:
    """Load release/milestones.toml. Raises FileNotFoundError if missing."""
    path = repo_root / "release" / "milestones.toml"
    if not path.exists():
        raise FileNotFoundError(f"milestones file not found: {path}")
    with path.open("rb") as f:
        return tomllib.load(f)


def find_open_hardware_criteria(milestones: dict) -> list[Criterion]:
    """Find open hardware-gated criteria in milestones.toml.

    A criterion is "open hardware-gated" if:
      - verified = false
      - transcript = "" (empty)
      - note contains "PENDING PHASE D" or "hardware gate" (case-insensitive)
    """
    out: list[Criterion] = []
    for ms in milestones.get("milestone", []):
        ver = ms.get("version", "<unknown>")
        for c in ms.get("criteria_status", []):
            crit_text = c.get("criterion", "<unnamed>")
            verified = c.get("verified", False)
            transcript = c.get("transcript", "")
            note = c.get("note", "")
            if verified:
                continue
            if transcript:
                continue
            note_lower = note.lower()
            is_hw_gated = "pending phase d" in note_lower or "hardware gate" in note_lower
            if not is_hw_gated:
                continue
            # Determine which slot this criterion requires.
            requires_slot = ""
            if "battery" in crit_text.lower() or "battery" in note_lower:
                requires_slot = "laptop"
            elif "two machines" in note_lower or "responsiveness" in crit_text.lower():
                requires_slot = ""  # both slots
            out.append(Criterion(
                milestone=ver,
                criterion=crit_text,
                verified=verified,
                transcript=transcript,
                note=note,
                is_hardware_gated=True,
                requires_slot=requires_slot,
            ))
    return out


def find_existing_evidence(repo_root: Path) -> list[str]:
    """Find existing evidence bundles under release/evidence/host-bench/.

    Returns a list of repo-relative paths to directories that contain a
    hwtest-manifest.json (the new schema) OR a meta.txt (the old shape).
    Excludes _TEMPLATE/ and directories marked as defective.
    """
    host_bench = repo_root / "release" / "evidence" / "host-bench"
    if not host_bench.exists():
        return []
    out: list[str] = []
    for d in sorted(host_bench.iterdir()):
        if not d.is_dir():
            continue
        if d.name == "_TEMPLATE":
            continue
        # Check for new-schema manifest or old-shape meta.txt.
        if (d / "hwtest-manifest.json").exists() or (d / "meta.txt").exists():
            rel = d.relative_to(repo_root)
            out.append(str(rel))
    return out


def is_evidence_satisfied(criterion: Criterion, existing_evidence: list[str], slot: str) -> bool:
    """Check if a criterion is already satisfied by existing evidence.

    A criterion is satisfied if there's at least one existing evidence bundle
    that matches the required slot. This is a conservative check — it doesn't
    verify the bundle's content (that's the validator's job); it only checks
    existence to prevent duplicate required work.
    """
    if not existing_evidence:
        return False
    # If the criterion requires a laptop and we have laptop evidence, it's satisfied.
    # If the criterion requires both slots and we have at least 2 bundles, it's satisfied.
    if criterion.requires_slot == "laptop":
        # Check if any existing bundle is for a laptop (by name or manifest).
        for path in existing_evidence:
            if "laptop" in path.lower() or "victus" in path.lower():
                return True
        return False
    if criterion.requires_slot == "":
        # Both slots required — need at least 2 bundles.
        return len(existing_evidence) >= 2
    return False


# ─── Plan generation ─────────────────────────────────────────────────────────


def generate_plan(
    repo_root: Path,
    hw: HardwareState,
    slot_override: str | None = None,
    dry_run: bool = False,
    generated_at: str | None = None,
) -> Plan:
    """Generate a Plan from repo state + hardware state.

    The planner is DETERMINISTIC: the same inputs always produce the same Plan.
    The `generated_at` timestamp comes from the caller (or defaults to a fixed
    test value) so the Plan is reproducible.
    """
    # Use a fixed timestamp for determinism if not provided.
    if generated_at is None:
        generated_at = "2026-07-04T12:00:00Z"

    version = read_version(repo_root)
    commit = read_git_commit(repo_root)
    milestones = read_milestones(repo_root)
    open_criteria = find_open_hardware_criteria(milestones)
    existing_evidence = find_existing_evidence(repo_root)

    # Determine slot.
    if slot_override:
        slot = slot_override
        confidence = "high"
        ambiguities: list[str] = []
        if slot_override == "laptop" and not hw.battery_present:
            ambiguities.append(
                "slot overridden to 'laptop' but no battery detected — "
                "battery-dependent criteria cannot be satisfied on this machine"
            )
    else:
        slot, confidence, ambiguities = hw.slot()

    # Filter criteria to those relevant for this slot.
    relevant_criteria: list[Criterion] = []
    for c in open_criteria:
        if c.requires_slot and c.requires_slot != slot and slot != "ambiguous":
            # This criterion requires a different slot — skip it.
            continue
        if is_evidence_satisfied(c, existing_evidence, slot):
            # Already satisfied — skip it.
            continue
        relevant_criteria.append(c)

    # Build the plan steps.
    steps: list[PlanStep] = []
    seq = 0

    # Step 0: capture session start (always proceed — non-destructive).
    run_dir = f"release/evidence/host-bench/<date>-<hostname>/"
    steps.append(PlanStep(
        seq=seq,
        kind="command",
        default="proceed",
        reason=f"start capture session for slot={slot} ({len(relevant_criteria)} open criteria)",
        rollback="rush-capture finish --run-dir <run-dir>",
        argv=["rush-capture", "start", "--run-dir", run_dir, "--repo-root", str(repo_root)],
    ))
    seq += 1

    # If there are no open criteria, the plan is just the session start + finish.
    if not relevant_criteria:
        steps.append(PlanStep(
            seq=seq,
            kind="command",
            default="proceed",
            reason="no open hardware-gated criteria for this slot — closing session cleanly",
            rollback="rush-capture finish --run-dir <run-dir>",
            argv=["rush-capture", "finish", "--run-dir", run_dir],
        ))
        seq += 1
    else:
        # Physical prompt: boot/prepare the reference machine (if not already on).
        if slot == "laptop":
            steps.append(PlanStep(
                seq=seq,
                kind="physical-prompt",
                default="wait",
                reason="benchmark requires the reference laptop to be running and reachable",
                rollback="N/A (physical action — no software rollback)",
                action="Boot the reference laptop and ensure SSH is reachable",
                detection_signal="ssh <user>@<laptop-host> 'echo READY' every 30s",
                timeout="10m",
            ))
            seq += 1

            # For laptop: battery run requires unplugging AC.
            steps.append(PlanStep(
                seq=seq,
                kind="physical-prompt",
                default="wait",
                reason="Criterion 3 (battery behavior) requires a battery-only run with AC unplugged",
                rollback="N/A (physical action — operator replugs AC)",
                action="Unplug the laptop's AC adapter to run on battery",
                detection_signal="read /sys/class/power_supply/AC*/online == 0 every 5s",
                timeout="5m",
            ))
            seq += 1

        # Baseline run (PPD balanced).
        steps.append(PlanStep(
            seq=seq,
            kind="command",
            default="proceed",
            reason="baseline run (PPD balanced) for mixed-load-001 preset, 5 samples",
            rollback="rush-capture finish --run-dir <run-dir>",
            argv=[
                "rush-exec",
                "--run-dir", run_dir,
                "--",
                "rushbench", "run", "preset=mixed-load-001",
                "--tag=baseline-<hostname>",
                "--samples=5",
            ],
        ))
        seq += 1

        # Optid run (optid --apply).
        steps.append(PlanStep(
            seq=seq,
            kind="command",
            default="proceed",
            reason="optid run (--apply) for mixed-load-001 preset, 5 samples — paired with baseline",
            rollback="rush-capture finish --run-dir <run-dir>",
            argv=[
                "rush-exec",
                "--run-dir", run_dir,
                "--",
                "rushbench", "run", "preset=mixed-load-001",
                "--tag=optid-<version>-<hostname>",
                "--samples=5",
                "--apply",
            ],
        ))
        seq += 1

        # Finish capture session.
        steps.append(PlanStep(
            seq=seq,
            kind="command",
            default="proceed",
            reason="finish capture session — writes summary.md and privacy-report.json",
            rollback="N/A (finish is idempotent)",
            argv=["rush-capture", "finish", "--run-dir", run_dir],
        ))
        seq += 1

        # Validation step.
        steps.append(PlanStep(
            seq=seq,
            kind="validation",
            default="proceed",
            reason="validate the captured evidence bundle against the hardware evidence schema",
            rollback="N/A (validation is read-only)",
            validator="validate-hwtest-evidence.py",
            bundle=run_dir.rstrip("/"),
        ))
        seq += 1

    plan = Plan(
        generated_at=generated_at,
        source_version=version,
        source_commit=commit,
        repo_root=str(repo_root),
        hardware_slot=slot,
        slot_confidence=confidence,
        ambiguities=ambiguities,
        open_criteria=[
            {
                "milestone": c.milestone,
                "criterion": c.criterion,
                "requires_slot": c.requires_slot or "both",
            }
            for c in relevant_criteria
        ],
        existing_evidence=existing_evidence,
        steps=steps,
        dry_run=dry_run,
    )
    return plan


# ─── Safety check ────────────────────────────────────────────────────────────


# Actions that are destructive (docs/automation-human-interface.md §2.4) or
# final-approval (§2.5). The planner must NEVER produce default="proceed" for
# any of these. This is the load-bearing safety floor.
DESTRUCTIVE_PATTERNS = [
    "git push --force",
    "git push --force-with-lease",
    "rm -rf",
    "git clean -fd",
    "repartition",
    "dd if=",
    "mkfs",
    "fdisk",
    "sgdisk",
    "delete",
    "remove",
]

FINAL_APPROVAL_PATTERNS = [
    "merge",
    "git merge",
    "gh pr merge",
    "verified = true",
    "bump version",
    "ratify",
    "tag v",
    "git tag",
    "git push origin v",
]


def check_safety_floor(plan: Plan) -> list[str]:
    """Verify no PlanStep has default=proceed for a destructive or final-approval action.

    Returns a list of violation strings (empty = safe).
    """
    violations: list[str] = []
    for step in plan.steps:
        if step.default != "proceed":
            continue
        # Check the argv (if present) against destructive/final-approval patterns.
        argv_str = " ".join(step.argv) if step.argv else ""
        action_str = step.action or ""
        text = (argv_str + " " + action_str).lower()
        for pat in DESTRUCTIVE_PATTERNS:
            if pat in text:
                violations.append(
                    f"step {step.seq}: default=proceed for destructive action matching {pat!r}: {text!r}"
                )
        for pat in FINAL_APPROVAL_PATTERNS:
            if pat in text:
                violations.append(
                    f"step {step.seq}: default=proceed for final-approval action matching {pat!r}: {text!r}"
                )
    return violations


# ─── CLI ─────────────────────────────────────────────────────────────────────


def cmd_plan(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    if not repo_root.exists():
        print(f"rush-autopilot: repo root not found: {repo_root}", file=sys.stderr)
        return 2

    # Hardware detection.
    fake_sys = Path(args.fake_sys).resolve() if args.fake_sys else None
    if fake_sys and not fake_sys.exists():
        print(f"rush-autopilot: --fake-sys path not found: {fake_sys}", file=sys.stderr)
        return 2
    hw = detect_hardware(fake_sys)

    # Load milestones to verify it exists.
    try:
        milestones = read_milestones(repo_root)
    except FileNotFoundError as e:
        print(f"rush-autopilot: {e}", file=sys.stderr)
        return 1

    # Generate the plan.
    slot_override = args.slot
    dry_run = args.dry_run or args.auto is False
    # For determinism, use a fixed timestamp unless --auto is set (real run).
    # Actually, for true determinism, ALWAYS use a fixed timestamp in the plan
    # output. The generated_at field is metadata, not a decision input.
    generated_at = "2026-07-04T12:00:00Z"

    plan = generate_plan(
        repo_root=repo_root,
        hw=hw,
        slot_override=slot_override,
        dry_run=dry_run,
        generated_at=generated_at,
    )

    # Safety floor check.
    violations = check_safety_floor(plan)
    if violations:
        print("rush-autopilot: SAFETY FLOOR VIOLATED — plan rejected:", file=sys.stderr)
        for v in violations:
            print(f"  ✗ {v}", file=sys.stderr)
        return 1

    # Output the plan.
    plan_dict = plan.to_dict()
    output_text = json.dumps(plan_dict, indent=2, sort_keys=True)

    if args.output:
        out_path = Path(args.output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(output_text + "\n")
        print(f"rush-autopilot: plan written to {out_path}", file=sys.stderr)
    else:
        print(output_text)

    # Report ambiguities to stderr.
    if plan.ambiguities:
        print("\nrush-autopilot: ambiguities detected:", file=sys.stderr)
        for a in plan.ambiguities:
            print(f"  ⚠ {a}", file=sys.stderr)

    return 0


# ─── run / resume subcommands ────────────────────────────────────────────────


def cmd_run(args: argparse.Namespace) -> int:
    """Execute a plan."""
    # Import the runner library.
    sys.path.insert(0, str(TOOLS_DIR))
    import rush_runner_lib as runner

    plan_path = Path(args.plan).resolve()
    run_dir = Path(args.run_dir).resolve()
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    fake_sys = Path(args.fake_sys).resolve() if args.fake_sys else None
    fake = args.fake or args.dry_run  # dry-run implies fake

    if not plan_path.exists():
        print(f"rush-autopilot: plan file not found: {plan_path}", file=sys.stderr)
        return 2

    result = runner.execute_plan_file(
        plan_path=plan_path,
        run_dir=run_dir,
        fake=fake,
        fake_sys=fake_sys,
        repo_root=repo_root,
        resume=args.resume,
    )

    # If the run failed and --dev-if-fail is set, run the AI repair loop.
    if result.get("status") == "aborted" and getattr(args, "dev_if_fail", False):
        import rush_agent_lib as agent
        dev_record = agent.dev_if_fail(
            run_dir=run_dir,
            repo_root=repo_root,
            provider=getattr(args, "provider", "mock"),
            max_iterations=getattr(args, "max_iterations", 3),
            fake=True,  # dev-if-fail is always fake for safety
            fake_sys=fake_sys,
        )
        result["dev_if_fail"] = dev_record
        if dev_record.get("status") == "passed":
            result["status"] = "completed-with-ai-repair"

    # Print the run record.
    print(json.dumps(result, indent=2, sort_keys=True))

    if result.get("status") in ("completed", "completed-with-ai-repair"):
        return 0
    elif result.get("status") == "aborted":
        return 1
    else:
        return 1


def cmd_resume(args: argparse.Namespace) -> int:
    """Resume an interrupted run."""
    sys.path.insert(0, str(TOOLS_DIR))
    import rush_runner_lib as runner

    run_dir = Path(args.run_dir).resolve()
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    fake_sys = Path(args.fake_sys).resolve() if args.fake_sys else None

    # Find the plan file.
    if args.plan:
        plan_path = Path(args.plan).resolve()
    else:
        # Look for a plan.json in the run-dir.
        plan_path = run_dir / "plan.json"
    if not plan_path.exists():
        print(f"rush-autopilot: plan file not found: {plan_path}", file=sys.stderr)
        return 2

    result = runner.execute_plan_file(
        plan_path=plan_path,
        run_dir=run_dir,
        fake=args.fake,
        fake_sys=fake_sys,
        repo_root=repo_root,
        resume=True,
    )

    print(json.dumps(result, indent=2, sort_keys=True))

    if result.get("status") == "completed":
        return 0
    return 1


# ─── dev-if-fail subcommand ──────────────────────────────────────────────────


def cmd_dev_if_fail(args: argparse.Namespace) -> int:
    """Run the dev-if-fail loop on a failed run directory."""
    sys.path.insert(0, str(TOOLS_DIR))
    import rush_agent_lib as agent

    run_dir = Path(args.run_dir).resolve()
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    fake_sys = Path(args.fake_sys).resolve() if args.fake_sys else None
    fake = args.fake or True  # dev-if-fail defaults to fake mode for safety

    record = agent.dev_if_fail(
        run_dir=run_dir,
        repo_root=repo_root,
        provider=args.provider,
        max_iterations=args.max_iterations,
        fake=fake,
        fake_sys=fake_sys,
    )

    print(json.dumps(record, indent=2, sort_keys=True))

    if record.get("status") == "passed":
        return 0
    return 1


# ─── submit-evidence / submit-failing-evidence / submit-code-pr subcommands ──


def cmd_submit_evidence(args: argparse.Namespace) -> int:
    """Submit evidence PR from a run directory."""
    sys.path.insert(0, str(TOOLS_DIR))
    import rush_pr_lib as pr_lib

    run_dir = Path(args.run_dir).resolve()
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    dry_run = args.dry_run

    if not run_dir.exists():
        print(f"rush-autopilot: run-dir not found: {run_dir}", file=sys.stderr)
        return 2

    failing = args.command == "submit-failing-evidence"
    plan = pr_lib.prepare_evidence_pr(
        run_dir=run_dir,
        repo_root=repo_root,
        failing=failing,
        dry_run=dry_run,
    )

    # Print the plan.
    print(json.dumps(plan.to_dict(), indent=2, sort_keys=True))

    # In dry-run mode, exit here.
    if dry_run:
        return 0 if plan.validation_ok or failing else 1

    # In non-dry-run mode, execute the submission.
    result = pr_lib.execute_submission(plan, run_dir, repo_root)
    print(json.dumps(result, indent=2, sort_keys=True))

    if result.get("status") == "pr-opened":
        return 0
    return 1


def cmd_submit_code_pr(args: argparse.Namespace) -> int:
    """Submit a code PR from a branch."""
    sys.path.insert(0, str(TOOLS_DIR))
    import rush_pr_lib as pr_lib

    branch = args.branch
    repo_root = Path(args.repo).resolve() if args.repo else ROOT
    dry_run = args.dry_run

    plan = pr_lib.prepare_code_pr(
        branch=branch,
        repo_root=repo_root,
        dry_run=dry_run,
    )

    print(json.dumps(plan.to_dict(), indent=2, sort_keys=True))

    if dry_run:
        return 0

    result = pr_lib.execute_submission(plan, None, repo_root)
    print(json.dumps(result, indent=2, sort_keys=True))

    if result.get("status") == "pr-opened":
        return 0
    return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="rush-autopilot",
        description="Deterministic planner + runner for Rush LiveDev benchmark campaigns.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # ── plan subcommand ──
    p_plan = sub.add_parser("plan", help="Generate a benchmark campaign plan.")
    p_plan.add_argument("--auto", action="store_true", default=False,
                        help="Generate a plan for execution (non-dry-run).")
    p_plan.add_argument("--dry-run", action="store_true", default=False,
                        help="Generate a dry-run plan (no destructive actions).")
    p_plan.add_argument("--slot", choices=["laptop", "desktop", "server", "realtime-capable"],
                        default=None, help="Override the detected hardware slot.")
    p_plan.add_argument("--output", type=str, default=None,
                        help="Write the plan to this path (default: stdout).")
    p_plan.add_argument("--repo", type=str, default=None,
                        help="Path to the repo root (default: auto-detect).")
    p_plan.add_argument("--fake-sys", type=str, default=None,
                        help="Path to a fake sysfs/proc root for testing (e.g. /tmp/fake-sys).")
    p_plan.set_defaults(func=cmd_plan)

    # ── run subcommand ──
    p_run = sub.add_parser("run", help="Execute a plan.")
    p_run.add_argument("--plan", type=str, required=True,
                       help="Path to the plan JSON file to execute.")
    p_run.add_argument("--run-dir", type=str, required=True,
                      help="Path to the capture run directory.")
    p_run.add_argument("--auto", action="store_true", default=False,
                       help="Execute the plan (non-dry-run).")
    p_run.add_argument("--dry-run", action="store_true", default=False,
                       help="Execute the plan in dry-run mode (no destructive actions).")
    p_run.add_argument("--fake", action="store_true", default=False,
                       help="Fake execution: no real commands, fake sysfs transitions, fake results.")
    p_run.add_argument("--fake-sys", type=str, default=None,
                       help="Path to a fake sysfs/proc root for physical-prompt simulation.")
    p_run.add_argument("--repo", type=str, default=None,
                       help="Path to the repo root (default: auto-detect).")
    p_run.add_argument("--resume", action="store_true", default=False,
                       help="Resume an interrupted run (skip completed steps).")
    p_run.add_argument("--dev-if-fail", action="store_true", default=False,
                       help="Run dev-if-fail AI repair loop if the plan fails.")
    p_run.add_argument("--provider", default="mock", choices=["mock", "http"],
                       help="AI provider for dev-if-fail (default: mock).")
    p_run.add_argument("--max-iterations", type=int, default=3,
                       help="Max dev-if-fail iterations (default: 3).")
    p_run.set_defaults(func=cmd_run)

    # ── resume subcommand ──
    p_resume = sub.add_parser("resume", help="Resume an interrupted run.")
    p_resume.add_argument("--run-dir", type=str, required=True,
                          help="Path to the capture run directory to resume.")
    p_resume.add_argument("--plan", type=str, default=None,
                          help="Path to the plan JSON (if not set, read from run-dir).")
    p_resume.add_argument("--fake", action="store_true", default=False,
                          help="Fake execution mode.")
    p_resume.add_argument("--fake-sys", type=str, default=None,
                          help="Path to a fake sysfs/proc root.")
    p_resume.add_argument("--repo", type=str, default=None,
                          help="Path to the repo root.")
    p_resume.set_defaults(func=cmd_resume)

    # ── dev-if-fail subcommand ──
    p_dev = sub.add_parser("dev-if-fail", help="Run AI-assisted repair on a failed run.")
    p_dev.add_argument("--run-dir", type=str, required=True,
                       help="Path to the failed run directory.")
    p_dev.add_argument("--provider", default="mock", choices=["mock", "http"],
                       help="AI provider (default: mock).")
    p_dev.add_argument("--max-iterations", type=int, default=3,
                       help="Max iterations (default: 3).")
    p_dev.add_argument("--fake", action="store_true", default=True,
                       help="Fake mode (default: True — dev-if-fail is always fake for safety).")
    p_dev.add_argument("--fake-sys", type=str, default=None,
                       help="Path to a fake sysfs/proc root.")
    p_dev.add_argument("--repo", type=str, default=None,
                       help="Path to the repo root.")
    p_dev.set_defaults(func=cmd_dev_if_fail)

    # ── submit-evidence subcommand ──
    p_se = sub.add_parser("submit-evidence", help="Submit an evidence PR from a run directory.")
    p_se.add_argument("--run-dir", type=str, required=True, help="Path to the run directory.")
    p_se.add_argument("--dry-run", action="store_true", default=False, help="Dry-run: show plan without pushing.")
    p_se.add_argument("--repo", type=str, default=None, help="Path to the repo root.")
    p_se.set_defaults(func=cmd_submit_evidence)

    # ── submit-failing-evidence subcommand ──
    p_sfe = sub.add_parser("submit-failing-evidence", help="Submit a failing evidence PR (for diagnosis).")
    p_sfe.add_argument("--run-dir", type=str, required=True, help="Path to the run directory.")
    p_sfe.add_argument("--dry-run", action="store_true", default=False, help="Dry-run: show plan without pushing.")
    p_sfe.add_argument("--repo", type=str, default=None, help="Path to the repo root.")
    p_sfe.set_defaults(func=cmd_submit_evidence)

    # ── submit-code-pr subcommand ──
    p_scp = sub.add_parser("submit-code-pr", help="Submit a code PR from a branch.")
    p_scp.add_argument("--branch", type=str, required=True, help="Branch name to submit.")
    p_scp.add_argument("--dry-run", action="store_true", default=False, help="Dry-run: show plan without pushing.")
    p_scp.add_argument("--repo", type=str, default=None, help="Path to the repo root.")
    p_scp.set_defaults(func=cmd_submit_code_pr)

    ns = parser.parse_args(argv)
    return ns.func(ns)


if __name__ == "__main__":
    sys.exit(main())
