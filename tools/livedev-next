        print(stdout.strip()[-500:])
    if rc == 0:
        print()
        print(f"  [OK] Plan executed. Run dir: {run_dir}")
        print()
        print("  Next: submit the evidence:")
        print(f"    python3 tools/livedev-next --submit {run_dir} --dry-run")
    else:
        print()
        print(f"  [FAIL] Plan execution failed (exit {rc})")
    print()
    return rc


# --- Submit -----------------------------------------------------------------


def cmd_submit(run_dir: str, dry_run: bool) -> int:
    print("=" * 60)
    print("  Rush LiveDev - Submit Evidence")
    print("=" * 60)
    print()

    if not Path(run_dir).exists():
        print(f"  [FAIL] Run directory not found: {run_dir}")
        return 1

    if dry_run:
        cmd = [
            "python3", "tools/rush-autopilot", "submit-evidence",
            "--run-dir", run_dir, "--dry-run",
        ]
        print(f"  Mode: dry-run (no push, no PR, no merge)")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        if stdout.strip():
            print(stdout.strip()[-1000:])
        if rc == 0:
            print()
            print("  [OK] Dry-run complete.")
            print()
            print("  To submit for real (opens a PR for maintainer review):")
            print(f"    python3 tools/livedev-next --submit {run_dir}")
        else:
            print()
            print(f"  [FAIL] Dry-run failed (exit {rc})")
            if stderr.strip():
                print(f"     {stderr.strip()[-300:]}")
        return rc
    else:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if not token:
            print("[TOKEN NEEDED]")
            print("Export GH_TOKEN, then rerun the submit command.")
            return 2

        cmd = [
            "python3", "tools/rush-autopilot", "submit-evidence",
            "--run-dir", run_dir,
        ]
        print(f"  Mode: real (will push branch + open PR for maintainer review)")
        print(f"  No auto-merge. A maintainer reviews and merges.")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=120)
        if stdout.strip():
            print(stdout.strip()[-500:])
        if rc == 0:
            print()
            print("  [OK] PR opened. Check the output above for the PR URL.")
        else:
            print()
            print(f"  [FAIL] Submission failed (exit {rc})")
        return rc


# --- Prepare USB ------------------------------------------------------------


def cmd_prepare_usb(dry_run: bool = False) -> int:
    print("=" * 60)
    print("  Rush LiveDev - Prepare USB")
    print("=" * 60)
    print()

    bootstrap_sh = _REPO_ROOT / "tools/livedev-bootstrap.sh"
    testos_install = _REPO_ROOT / "testos/install.sh"
    testos_install_ps1 = _REPO_ROOT / "testos/install.ps1"

    print("  Using testOS as the current LiveDev boot backend.")
    print()

    if not testos_install.exists() and not testos_install_ps1.exists():
        print("  [FAIL] No testOS installer found (testos/install.sh or testos/install.ps1).")
        return 1

    if dry_run:
        print("  [dry-run] Would prepare the USB by invoking the testOS installer.")
        print("  [dry-run] The exact command depends on your OS:")
        print()
        if bootstrap_sh.exists():
            print("    Linux/macOS:")
            print("      bash tools/livedev-bootstrap.sh --auto")
            print("    Or call the testOS installer directly:")
            print("      sudo bash testos/install.sh")
            print("      sudo bash testos/install.sh /dev/sdX   # explicit device")
        print()
        print("    Windows PowerShell:")
        print("      powershell -ExecutionPolicy Bypass -File tools/livedev-bootstrap.ps1 -Auto")
        print("      powershell -ExecutionPolicy Bypass -File testos/install.ps1")
        print()
        print("  [dry-run] Not writing USB.")
        return 0

    # Real prep: prefer the bootstrap script (it does repo sync + mock + plan first).
    if bootstrap_sh.exists():
        print("  Running: bash tools/livedev-bootstrap.sh --auto")
        print("  (This will sync the repo, run mock verification, generate a plan,")
        print("   then prepare the USB using testOS as the boot backend.)")
        print()
        rc, stdout, stderr = _run(
            ["bash", str(bootstrap_sh), "--auto"], cwd=_REPO_ROOT, timeout=1800
        )
        if stdout.strip():
            print(stdout.strip()[-1500:])
        if rc != 0:
            print(f"  [FAIL] bootstrap.sh exited {rc}")
            if stderr.strip():
                print(f"     {stderr.strip()[-300:]}")
        return rc

    print("  [FAIL] tools/livedev-bootstrap.sh not found. Cannot prepare USB.")
    return 1


# --- Resume -----------------------------------------------------------------


def cmd_resume(dry_run: bool = False, submit: bool = False) -> int:
    print("=" * 60)
    print("  Rush LiveDev - Resume After Reboot")
    print("=" * 60)
    print()

    bootstrap_sh = _REPO_ROOT / "tools/livedev-bootstrap.sh"

    if not bootstrap_sh.exists():
        print("  [FAIL] tools/livedev-bootstrap.sh not found. Cannot resume.")
        return 1

    args = ["--resume"]
    if dry_run:
        args.append("--dry-run")
    if submit:
        args.append("--submit")

    print("  Running: bash tools/livedev-bootstrap.sh " + " ".join(args))
    print("  (This will scan for the USB, copy results, validate, and run submit dry-run.)")
    if submit:
        print("  -Submit requested: will open a real evidence PR (no auto-merge).")
    print()

    rc, stdout, stderr = _run(
        ["bash", str(bootstrap_sh)] + args, cwd=_REPO_ROOT, timeout=1800
    )
    if stdout.strip():
        print(stdout.strip()[-2000:])
    if rc != 0:
        print(f"  [FAIL] bootstrap.sh exited {rc}")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
    return rc


# --- CLI --------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="livedev-next",
        description="Single entrypoint for Rush LiveDev operations.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--auto", action="store_true",
        help="Run the full pipeline: plan -> run -> validate -> submit (dry-run). "
             "With --dry-run, shows the pipeline without writing USB.",
    )
    group.add_argument("--mock", action="store_true", help="Run mock tests (no hardware, no network).")
    group.add_argument("--plan", action="store_true", help="Generate a benchmark plan.")
    group.add_argument("--run", type=str, metavar="PLAN_PATH", help="Execute a plan.")
    group.add_argument(
        "--submit", type=str, metavar="RUN_DIR",
        help="Submit evidence from a run directory.",
    )
    group.add_argument(
        "--prepare-usb", action="store_true",
        help="Prepare a USB using the current testOS boot backend.",
    )
    group.add_argument(
        "--resume", action="store_true",
        help="Resume after reboot: copy results, validate, submit dry-run.",
    )
    parser.add_argument(
        "--dry-run", action="store_true", default=False,
        help="Dry-run mode for --auto (show pipeline, do not write USB) or --submit.",
    )
    parser.add_argument(
        "--submit-real", action="store_true", default=False,
        help="Used with --resume: open a real evidence PR (no auto-merge).",
    )
    ns = parser.parse_args(argv)

    if ns.auto:
        return cmd_auto(dry_run=ns.dry_run)
    if ns.mock:
        return cmd_mock()
    if ns.plan:
        return cmd_plan()
    if ns.run:
        return cmd_run(ns.run)
    if ns.submit:
        return cmd_submit(ns.submit, ns.dry_run)
    if ns.prepare_usb:
        return cmd_prepare_usb(dry_run=ns.dry_run)
    if ns.resume:
        return cmd_resume(dry_run=ns.dry_run, submit=ns.submit_real)
    return cmd_default()


if __name__ == "__main__":
    sys.exit(main())
