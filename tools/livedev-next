# --- Auto (full pipeline) ---------------------------------------------------


def cmd_auto(dry_run: bool = False) -> int:
    """Run the full pipeline: plan -> run -> validate -> submit (dry-run).

    With --dry-run, prints every command instead of executing it. Does not
    write a USB -- USB preparation is --prepare-usb's job, and the full
    one-command USB workflow is the bootstrap script's job.

    Saves a persistent checkpoint at each phase so the operator can resume
    with a single generated command after reboot. Collects a privacy-safe
    hardware inventory into the run_dir automatically.
    """
    print("=" * 60)
    print("  Rush LiveDev - Full Pipeline")
    print("=" * 60)
    print()

    if dry_run:
        print("  [dry-run] Showing the full pipeline. No commands are executed.")
        print("  [dry-run] USB is not written. Use tools/livedev-bootstrap.sh --auto")
        print("  [dry-run]   for the full one-command USB workflow.")
        print()

    # Generate a run_id for this pipeline run. Used for checkpoint state.
    import datetime
    run_id = datetime.datetime.now(datetime.timezone.utc).strftime("auto-%Y%m%d-%H%M%S")
    # SECURITY: use a persistent run directory under XDG_DATA_HOME so the
    # inventory and results survive reboot. This is the same location
    # bootstrap.sh uses, so livedev-next --auto and bootstrap.sh --auto
    # share the same persistent layout.
    xdg_data = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.environ.get("HOME", "/tmp"), ".local", "share"
    )
    run_dir = os.path.join(xdg_data, "rush-livedev", "runs", run_id)
    os.makedirs(run_dir, exist_ok=True)
    plan_path = os.path.join(run_dir, "plan.json")

    # Step 0: Collect privacy-safe hardware inventory.
    # This is collected BEFORE any benchmark runs so the inventory reflects
    # the host's baseline capabilities, not any state changed by optid.
    print("  Step 0/4: Collecting privacy-safe hardware inventory...")
    if dry_run:
        print(f"    [dry-run] python3 tools/collect-hardware-inventory.py --output {run_dir}/hardware-inventory.json")
        inventory_path = ""
    else:
        inventory_path = _collect_hardware_inventory(run_dir)
        if inventory_path:
            print(f"    [OK] Inventory: {inventory_path}")
        else:
            print("    [WARN] Inventory collection skipped (non-fatal)")
    _checkpoint_save(run_id, "preflight", run_dir=run_dir,
                     plan_path=plan_path, inventory_path=inventory_path)
    print()

    # Step 1: Plan.
    print("  Step 1/4: Generating plan...")
    cmd = [
        PYTHON, "tools/rush-autopilot", "plan",
        "--dry-run", "--slot", "laptop", "--output", plan_path,
    ]
    if dry_run:
        print(f"    [dry-run] {' '.join(cmd)}")
        rc = 0
        stdout, stderr = "", ""
    else:
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        _print_result("Plan", rc, stdout)
    if rc != 0:
        print("\n  [FAIL] Pipeline failed at step 1 (plan).")
        if not dry_run and stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1
    _checkpoint_save(run_id, "plan_ready", run_dir=run_dir,
                     plan_path=plan_path, inventory_path=inventory_path)
    print()

    # Step 2: Run (fake mode - safe, no hardware).
    print("  Step 2/4: Executing plan (fake mode)...")
    cmd = [
        PYTHON, "tools/rush-autopilot", "run",
        "--plan", plan_path, "--run-dir", run_dir, "--fake",
    ]
    if dry_run:
        print(f"    [dry-run] {' '.join(cmd)}")
        rc = 0
        stdout, stderr = "", ""
    else:
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=300)
        _print_result("Run", rc, stdout)
    if rc != 0:
        print("\n  [FAIL] Pipeline failed at step 2 (run).")
        if not dry_run and stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1
    print()

    # Step 3: Validate.
    print("  Step 3/4: Validating evidence...")
    cmd = [PYTHON, "tools/validate-hwtest-evidence.py", "--bundle", run_dir]
    if dry_run:
        print(f"    [dry-run] {' '.join(cmd)}")
        rc = 0
        stdout, stderr = "", ""
    else:
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        _print_result("Validate", rc, stdout)
    if rc != 0:
        print("\n  [WARN] Evidence validation failed. The run completed but the evidence")
        print("     bundle has issues. You can still submit it as failing evidence:")
        print(f"     python3 tools/rush-autopilot submit-failing-evidence --run-dir {run_dir} --dry-run")
        print()
        print(f"  Run dir: {run_dir}")
        return 1
    _checkpoint_save(run_id, "validated", run_dir=run_dir,
                     plan_path=plan_path, inventory_path=inventory_path)
    print()

    # Step 4: Submit (dry-run).
    print("  Step 4/4: Preparing evidence PR (dry-run)...")
    cmd = [
        "python3", "tools/rush-autopilot", "submit-evidence",
        "--run-dir", run_dir, "--dry-run",
    ]
    if dry_run:
        print(f"    [dry-run] {' '.join(cmd)}")
        rc = 0
        stdout, stderr = "", ""
    else:
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        _print_result("Submit (dry-run)", rc, stdout)
    print()

    print("-" * 60)
    if dry_run:
        print("  [dry-run] Pipeline complete (no commands executed).")
    else:
        print(f"  [OK] Pipeline complete. Run dir: {run_dir}")
        if inventory_path:
            print(f"  [OK] Hardware inventory: {inventory_path}")
        print(f"  [OK] Checkpoint saved. Resume after reboot with:")
        print(f"       python3 tools/rush-livedev-checkpoint.py resume-command")
    print()
    print("  To submit for real (opens a PR for maintainer review):")
    print(f"    python3 tools/livedev-next --submit {run_dir}")
    print()
    print("  The tool will ask for GH_TOKEN when it needs it.")
    print("  It never merges the PR - that's the maintainer's job.")
    print()

    return 0


