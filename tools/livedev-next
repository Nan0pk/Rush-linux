# --- Submit -----------------------------------------------------------------


def cmd_submit(run_dir: str, dry_run: bool) -> int:
    print("=" * 60)
    print("  Rush LiveDev - Submit Evidence")
    print("=" * 60)
    print()

    if not Path(run_dir).exists():
        print(f"  [FAIL] Run directory not found: {run_dir}")
        return 1

    if dry_run:
        cmd = [
            PYTHON, "tools/rush-submit-evidence", run_dir,
            "--submit-mode", "auto", "--dry-run",
        ]
        print(f"  Mode: dry-run (no push, no PR, no merge)")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        if stdout.strip():
            print(stdout.strip()[-1000:])
        if rc == 0:
            print()
            print("  [OK] Dry-run complete.")
            print()
            print("  To submit for real (opens a PR for maintainer review):")
            print(f"    python3 tools/livedev-next --submit {run_dir}")
        else:
            print()
            print(f"  [FAIL] Dry-run failed (exit {rc})")
            if stderr.strip():
                print(f"     {stderr.strip()[-300:]}")
        return rc
    else:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        gh_ready = False
        if not token and shutil.which("gh"):
            gh_status = subprocess.run(
                ["gh", "auth", "status"], capture_output=True, text=True, timeout=10
            )
            gh_ready = gh_status.returncode == 0
        if not token and not gh_ready:
            print("[TOKEN NEEDED]")
            print("Authenticate with 'gh auth login' (recommended), or export GH_TOKEN.")
            return 2

        cmd = [
            PYTHON, "tools/rush-submit-evidence", run_dir,
            "--submit-mode", "auto",
        ]
        print(f"  Mode: real (will push branch + open PR for maintainer review)")
        print(f"  No auto-merge. A maintainer reviews and merges.")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=120)
        if stdout.strip():
            print(stdout.strip()[-500:])
        if rc == 0:
            print()
            print("  [OK] PR opened. Check the output above for the PR URL.")
            # Update checkpoint to mark submission complete.
            # Try to extract PR URL from stdout for the checkpoint record.
            pr_url = ""
            for line in stdout.splitlines():
                m = re.search(
                    r'https://github\.com/[^/\s]+/[^/\s]+/pull/\d+\b', line
                )
                if m:
                    pr_url = m.group(0)
                    break
            cp = _checkpoint_load()
            if cp:
                _checkpoint_save(
                    cp.get("run_id", "unknown"), "submitted",
                    run_dir=run_dir,
                    plan_path=cp.get("plan_path", ""),
                    inventory_path=cp.get("inventory_path", ""),
                    branch=cp.get("branch", ""),
                    pr_url=pr_url,
                )
        else:
            print()
            print(f"  [FAIL] Submission failed (exit {rc})")
        return rc


