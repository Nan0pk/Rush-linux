# --- Plan -------------------------------------------------------------------


def cmd_plan(baseline_only: bool = False, dry_run: bool = True) -> int:
    """Generate a benchmark plan.

    dry_run=True (default) produces a deterministic test plan.
    dry_run=False produces a physical-run plan with current UTC timestamp
    and dry_run=false, suitable for real hardware evidence.
    """
    print("=" * 60)
    print("  Rush LiveDev - Generate Plan")
    print("=" * 60)
    print()

    plan_path = str(Path(tempfile.gettempdir()) / "rush-livedev-plan.json")
    cmd = [PYTHON, "tools/rush-autopilot", "plan", "--slot", "laptop", "--output", plan_path]
    if dry_run:
        cmd.append("--dry-run")
    else:
        cmd.append("--auto")
    if baseline_only:
        cmd.append("--baseline-only")
    print(f"  Running: {' '.join(cmd)}")
    print()
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)

    if rc != 0:
        print(f"  [FAIL] Plan generation failed (exit {rc})")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1

    if Path(plan_path).exists():
        print(f"  [OK] Plan written to: {plan_path}")
        print()
        print("  Next: execute the plan:")
        print(f"    python3 tools/livedev-next --run {plan_path}")
        print()
        print("  Or run the full pipeline:")
        print("    python3 tools/livedev-next --auto")
    else:
        print(f"  [WARN] Plan command exited 0 but file not found at {plan_path}")
        return 1

    print()
    return 0


