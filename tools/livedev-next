#!/usr/bin/env python3
"""
tools/livedev-next — the single operator entrypoint for Rush LiveDev.

Usage:
  python3 tools/livedev-next              # show repo state + next commands
  python3 tools/livedev-next --auto       # full pipeline: plan → run → validate → submit dry-run
  python3 tools/livedev-next --mock       # run mock tests (no hardware, no network)
  python3 tools/livedev-next --plan       # generate a benchmark plan
  python3 tools/livedev-next --run PLAN   # execute a plan (fake mode by default)
  python3 tools/livedev-next --submit DIR --dry-run  # dry-run evidence submission
  python3 tools/livedev-next --submit DIR            # real evidence submission

This tool does NOT run destructive actions, does NOT request GH_TOKEN
(unless submit without --dry-run), and does NOT run hardware tests.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

_TOOLS_DIR = Path(__file__).resolve().parent
_REPO_ROOT = _TOOLS_DIR.parent

REQUIRED_TOOLS = [
    "tools/livedev-e2e-dry-run.py",
    "tools/rush-autopilot",
    "tools/validate-hwtest-evidence.py",
    "tools/rush-exec",
    "tools/rush-capture",
    "tools/rush-agent",
]


def _run(cmd: list[str], cwd: Path | None = None, timeout: int = 180) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, cwd=str(cwd) if cwd else None
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0]}"


def _print_result(label: str, rc: int, stdout: str) -> None:
    symbol = "✅" if rc == 0 else "❌"
    last_lines = stdout.strip().splitlines()[-3:] if stdout.strip() else []
    print(f"  {symbol} {label} (exit {rc})")
    for line in last_lines:
        print(f"       {line}")


# ─── Default ─────────────────────────────────────────────────────────────────


def cmd_default() -> int:
    print("═" * 60)
    print("  Rush LiveDev Next Step")
    print("═" * 60)
    print()

    print(f"  Repo root:   {_REPO_ROOT}")

    rc, branch, _ = _run(["git", "-C", str(_REPO_ROOT), "branch", "--show-current"])
    print(f"  Branch:      {branch.strip() if rc == 0 else 'unknown'}")

    rc, head, _ = _run(["git", "-C", str(_REPO_ROOT), "rev-parse", "HEAD"])
    print(f"  HEAD:        {head.strip()[:12] if rc == 0 else 'unknown'}")

    version_file = _REPO_ROOT / "VERSION"
    print(f"  VERSION:     {version_file.read_text().strip() if version_file.exists() else '(not found)'}")

    print()
    print("  Required LiveDev tools:")
    all_present = True
    for tool in REQUIRED_TOOLS:
        exists = (_REPO_ROOT / tool).exists()
        print(f"    {'✅' if exists else '❌'} {tool}")
        if not exists:
            all_present = False

    runner_wired = (_REPO_ROOT / "tools/rush_runner_lib.py").exists()
    submit_wired = (_REPO_ROOT / "tools/rush_pr_lib.py").exists()

    print()
    print(f"  Hardware runner:  {'✅ wired (rush-autopilot run)' if runner_wired else '❌ not wired'}")
    print(f"  Evidence submit:  {'✅ wired (rush-autopilot submit-evidence)' if submit_wired else '❌ not wired'}")

    print()
    print("  What is wired now:")
    print("    • Planner reads repo state + hardware, generates typed plans")
    print("    • Runner executes plans through rush-exec, captures tamper-evident evidence")
    print("    • Validator checks 14 semantic properties on evidence bundles")
    print("    • AI harness (mock) can diagnose failures and propose patches")
    print("    • PR submission prepares evidence PRs for maintainer review")

    print()
    print("  What is NOT wired yet:")
    print("    • Real AI providers (only mock available)")
    print("    • Real hardware evidence (no transcripts submitted)")
    print("    • LiveDev image boot (profile exists, not built on hardware)")

    print()
    print("─" * 60)
    print("  Next commands")
    print("─" * 60)
    print()
    print("  ★ Run the full pipeline automatically (plan → run → validate → submit):")
    print("    python3 tools/livedev-next --auto")
    print()
    print("  Or step by step:")
    print("    python3 tools/livedev-next --mock       # mock tests (no hardware)")
    print("    python3 tools/livedev-next --plan       # generate a plan")
    print(f"    python3 tools/livedev-next --run /tmp/rush-livedev-plan.json")
    print("    python3 tools/livedev-next --submit <RUN_DIR> --dry-run")
    print()
    print("  Full runbook: docs/livedev/OPERATOR_RUNBOOK.md")
    print()

    return 0 if all_present else 1


# ─── Auto (full pipeline) ────────────────────────────────────────────────────


def cmd_auto() -> int:
    """Run the full pipeline: plan → run → validate → submit (dry-run)."""
    print("═" * 60)
    print("  Rush LiveDev — Full Pipeline")
    print("═" * 60)
    print()

    run_dir = tempfile.mkdtemp(prefix="rush-livedev-auto-")
    plan_path = "/tmp/rush-livedev-plan.json"

    # Step 1: Plan.
    print("  Step 1/4: Generating plan...")
    cmd = [
        "python3", "tools/rush-autopilot", "plan",
        "--dry-run", "--slot", "laptop", "--output", plan_path,
    ]
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
    _print_result("Plan", rc, stdout)
    if rc != 0:
        print(f"\n  ❌ Pipeline failed at step 1 (plan).")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1
    print()

    # Step 2: Run (fake mode — safe, no hardware).
    print("  Step 2/4: Executing plan (fake mode)...")
    cmd = [
        "python3", "tools/rush-autopilot", "run",
        "--plan", plan_path, "--run-dir", run_dir, "--fake",
    ]
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=300)
    _print_result("Run", rc, stdout)
    if rc != 0:
        print(f"\n  ❌ Pipeline failed at step 2 (run).")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1
    print()

    # Step 3: Validate.
    print("  Step 3/4: Validating evidence...")
    cmd = ["python3", "tools/validate-hwtest-evidence.py", "--bundle", run_dir]
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
    _print_result("Validate", rc, stdout)
    if rc != 0:
        print(f"\n  ⚠️  Evidence validation failed. The run completed but the evidence")
        print(f"     bundle has issues. You can still submit it as failing evidence:")
        print(f"     python3 tools/rush-autopilot submit-failing-evidence --run-dir {run_dir} --dry-run")
        print()
        print(f"  Run dir: {run_dir}")
        return 1
    print()

    # Step 4: Submit (dry-run).
    print("  Step 4/4: Preparing evidence PR (dry-run)...")
    cmd = [
        "python3", "tools/rush-autopilot", "submit-evidence",
        "--run-dir", run_dir, "--dry-run",
    ]
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
    _print_result("Submit (dry-run)", rc, stdout)
    print()

    print("─" * 60)
    print(f"  ✅ Pipeline complete. Run dir: {run_dir}")
    print()
    print("  To submit for real (opens a PR for maintainer review):")
    print(f"    python3 tools/livedev-next --submit {run_dir}")
    print()
    print("  The tool will ask for GH_TOKEN when it needs it.")
    print("  It never merges the PR — that's the maintainer's job.")
    print()

    return 0


# ─── Mock ────────────────────────────────────────────────────────────────────


def cmd_mock() -> int:
    print("═" * 60)
    print("  Rush LiveDev — Mock Tests")
    print("═" * 60)
    print()

    commands = [
        (["python3", "tools/livedev-e2e-dry-run.py", "--success"], "E2E: success scenario"),
        (["python3", "tools/livedev-e2e-dry-run.py", "--failure-no-ai"], "E2E: failure (no AI)"),
        (["python3", "tools/livedev-e2e-dry-run.py", "--failure-with-ai-fix"], "E2E: failure (with AI fix)"),
        (["python3", "tools/validate-hwtest-evidence.py", "--fixtures"], "Evidence fixtures"),
    ]

    all_passed = True
    for cmd, label in commands:
        print(f"  ▸ {label}...")
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=180)
        _print_result(label, rc, stdout)
        if rc != 0:
            all_passed = False
        print()

    print("─" * 60)
    if all_passed:
        print("  ✅ All mock tests passed.")
        print()
        print("  Next: run the full pipeline:")
        print("    python3 tools/livedev-next --auto")
    else:
        print("  ❌ Some mock tests failed. Fix before proceeding.")
    print()
    return 0 if all_passed else 1


# ─── Plan ────────────────────────────────────────────────────────────────────


def cmd_plan() -> int:
    print("═" * 60)
    print("  Rush LiveDev — Generate Plan")
    print("═" * 60)
    print()

    plan_path = "/tmp/rush-livedev-plan.json"
    cmd = ["python3", "tools/rush-autopilot", "plan", "--dry-run", "--output", plan_path]
    print(f"  Running: {' '.join(cmd)}")
    print()
    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)

    if rc != 0:
        print(f"  ❌ Plan generation failed (exit {rc})")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return 1

    if Path(plan_path).exists():
        print(f"  ✅ Plan written to: {plan_path}")
        print()
        print("  Next: execute the plan:")
        print(f"    python3 tools/livedev-next --run {plan_path}")
        print()
        print("  Or run the full pipeline:")
        print("    python3 tools/livedev-next --auto")
    else:
        print(f"  ⚠️  Plan command exited 0 but file not found at {plan_path}")
        return 1

    print()
    return 0


# ─── Run ─────────────────────────────────────────────────────────────────────


def cmd_run(plan_path: str) -> int:
    print("═" * 60)
    print("  Rush LiveDev — Execute Plan")
    print("═" * 60)
    print()

    if not Path(plan_path).exists():
        print(f"  ❌ Plan file not found: {plan_path}")
        print()
        print("  Generate a plan first:")
        print("    python3 tools/livedev-next --plan")
        return 1

    run_dir = tempfile.mkdtemp(prefix="rush-livedev-run-")
    cmd = [
        "python3", "tools/rush-autopilot", "run",
        "--plan", plan_path, "--run-dir", run_dir, "--fake",
    ]
    print(f"  Plan:    {plan_path}")
    print(f"  Run dir: {run_dir}")
    print(f"  Mode:    fake (safe — no real hardware)")
    print()
    print(f"  Running: {' '.join(cmd)}")
    print()

    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=300)
    if stdout.strip():
        print(stdout.strip()[-500:])
    if rc == 0:
        print()
        print(f"  ✅ Plan executed. Run dir: {run_dir}")
        print()
        print("  Next: submit the evidence:")
        print(f"    python3 tools/livedev-next --submit {run_dir} --dry-run")
    else:
        print()
        print(f"  ❌ Plan execution failed (exit {rc})")
    print()
    return rc


# ─── Submit ──────────────────────────────────────────────────────────────────


def cmd_submit(run_dir: str, dry_run: bool) -> int:
    print("═" * 60)
    print("  Rush LiveDev — Submit Evidence")
    print("═" * 60)
    print()

    if not Path(run_dir).exists():
        print(f"  ❌ Run directory not found: {run_dir}")
        return 1

    if dry_run:
        cmd = [
            "python3", "tools/rush-autopilot", "submit-evidence",
            "--run-dir", run_dir, "--dry-run",
        ]
        print(f"  Mode: dry-run (no push, no PR)")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=60)
        if stdout.strip():
            print(stdout.strip()[-1000:])
        if rc == 0:
            print()
            print("  ✅ Dry-run complete.")
            print()
            print("  To submit for real (opens a PR for maintainer review):")
            print(f"    python3 tools/livedev-next --submit {run_dir}")
        else:
            print()
            print(f"  ❌ Dry-run failed (exit {rc})")
            if stderr.strip():
                print(f"     {stderr.strip()[-300:]}")
        return rc
    else:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if not token:
            print("[TOKEN NEEDED]")
            print("Export GH_TOKEN, then rerun the submit command.")
            return 2

        cmd = [
            "python3", "tools/rush-autopilot", "submit-evidence",
            "--run-dir", run_dir,
        ]
        print(f"  Mode: real (will push branch + open PR for maintainer review)")
        print()
        rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=120)
        if stdout.strip():
            print(stdout.strip()[-500:])
        if rc == 0:
            print()
            print("  ✅ PR opened. Check the output above for the PR URL.")
        else:
            print()
            print(f"  ❌ Submission failed (exit {rc})")
        return rc


# ─── CLI ─────────────────────────────────────────────────────────────────────


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="livedev-next",
        description="Single entrypoint for Rush LiveDev operations.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--auto", action="store_true",
        help="Run the full pipeline: plan → run → validate → submit (dry-run).",
    )
    group.add_argument("--mock", action="store_true", help="Run mock tests (no hardware, no network).")
    group.add_argument("--plan", action="store_true", help="Generate a benchmark plan.")
    group.add_argument("--run", type=str, metavar="PLAN_PATH", help="Execute a plan.")
    group.add_argument(
        "--submit", type=str, metavar="RUN_DIR",
        help="Submit evidence from a run directory.",
    )
    parser.add_argument(
        "--dry-run", action="store_true", default=False,
        help="Dry-run mode for submit.",
    )
    ns = parser.parse_args(argv)

    if ns.auto:
        return cmd_auto()
    if ns.mock:
        return cmd_mock()
    if ns.plan:
        return cmd_plan()
    if ns.run:
        return cmd_run(ns.run)
    if ns.submit:
        return cmd_submit(ns.submit, ns.dry_run)
    return cmd_default()


if __name__ == "__main__":
    sys.exit(main())
