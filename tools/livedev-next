def _run(cmd: list[str], cwd: Path | None = None, timeout: int = 180) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, cwd=str(cwd) if cwd else None
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0]}"


def _print_result(label: str, rc: int, stdout: str, stderr: str = "") -> None:
    symbol = "[OK]" if rc == 0 else "[FAIL]"
    diagnostic = stdout
    if rc != 0 and stderr.strip():
        diagnostic = f"{stdout.rstrip()}\n{stderr.rstrip()}"
    last_lines = diagnostic.strip().splitlines()[-6:] if diagnostic.strip() else []
    print(f"  {symbol} {label} (exit {rc})")
    for line in last_lines:
        print(f"       {line}")


