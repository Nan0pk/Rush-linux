    "resumes collection, validates results, and opens an evidence PR for "
    "maintainer review.\n"
    "You only approve USB erase, boot from USB, physical AC/battery prompts, "
    "and GitHub auth."
)


def _run(cmd: list[str], cwd: Path | None = None, timeout: int = 180) -> tuple[int, str, str]:
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, cwd=str(cwd) if cwd else None
        )
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0]}"


def _print_result(label: str, rc: int, stdout: str) -> None:
    symbol = "[OK]" if rc == 0 else "[FAIL]"
    last_lines = stdout.strip().splitlines()[-3:] if stdout.strip() else []
    print(f"  {symbol} {label} (exit {rc})")
    for line in last_lines:
        print(f"       {line}")


def _print_bootstrap_commands() -> None:
    print("Linux/macOS:")
    print(f"  {LINUX_MACOS_CMD}")
    print()
    print("Windows PowerShell:")
    print(f"  {WINDOWS_CMD}")
    print()
    print(USER_PATH_DESCRIPTION)


