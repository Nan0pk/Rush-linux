#!/usr/bin/env python3
"""
tools/livedev-next - the single operator entrypoint for Rush LiveDev.

Usage:
  python3 tools/livedev-next                          # show the one-command path + repo state
  python3 tools/livedev-next --mock                   # run mock tests (no hardware, no network)
  python3 tools/livedev-next --auto                   # full pipeline: plan -> run -> validate -> submit dry-run
  python3 tools/livedev-next --auto --dry-run         # show the full pipeline without writing USB
  python3 tools/livedev-next --prepare-usb            # call the testOS USB backend
  python3 tools/livedev-next --resume                 # call the bootstrap resume path (after reboot)
  python3 tools/livedev-next --plan                   # generate a benchmark plan
  python3 tools/livedev-next --run /tmp/plan.json     # execute a plan (fake mode by default)
  python3 tools/livedev-next --submit <RUN_DIR> --dry-run   # dry-run evidence submission
  python3 tools/livedev-next --submit <RUN_DIR>             # real evidence submission (no auto-merge)
  python3 tools/livedev-next --help

This tool does NOT run destructive actions, does NOT request GH_TOKEN
(only --submit without --dry-run does, and it prints exactly
"[TOKEN NEEDED]" if the token is missing), and does NOT run hardware
tests on its own.
"""

