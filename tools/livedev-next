    print("  Using testOS as the current LiveDev boot backend.")
    print()

    if not testos_install.exists() and not testos_install_ps1.exists():
        print("  [FAIL] No testOS installer found (testos/install.sh or testos/install.ps1).")
        return 1

    if dry_run:
        print("  [dry-run] Would prepare the USB by invoking the testOS installer.")
        print("  [dry-run] The exact command depends on your OS:")
        print()
        if bootstrap_sh.exists():
            print("    Linux/macOS:")
            print("      bash tools/livedev-bootstrap.sh --auto")
            print("    Or call the testOS installer directly:")
            print("      sudo bash testos/install.sh")
            print("      sudo bash testos/install.sh /dev/sdX   # explicit device")
        print()
        print("    Windows PowerShell:")
        print("      powershell -ExecutionPolicy Bypass -File tools/livedev-bootstrap.ps1 -Auto")
        print("      powershell -ExecutionPolicy Bypass -File testos/install.ps1")
        print()
        print("  [dry-run] Not writing USB.")
        return 0

    # Real prep: prefer the bootstrap script (it does repo sync + mock + plan first).
    if bootstrap_sh.exists():
        print("  Running: bash tools/livedev-bootstrap.sh --auto")
        print("  (This will sync the repo, run mock verification, generate a plan,")
        print("   then prepare the USB using testOS as the boot backend.)")
        print()
        rc, stdout, stderr = _run(
            ["bash", str(bootstrap_sh), "--auto"], cwd=_REPO_ROOT, timeout=1800
        )
        if stdout.strip():
            print(stdout.strip()[-1500:])
        if rc != 0:
            print(f"  [FAIL] bootstrap.sh exited {rc}")
            if stderr.strip():
                print(f"     {stderr.strip()[-300:]}")
        return rc

    print("  [FAIL] tools/livedev-bootstrap.sh not found. Cannot prepare USB.")
    return 1


# --- Resume -----------------------------------------------------------------


def cmd_resume(dry_run: bool = False, submit: bool = False) -> int:
    print("=" * 60)
    print("  Rush LiveDev - Resume After Reboot")
    print("=" * 60)
    print()

    # Load checkpoint to show the operator what phase we're resuming from.
    cp = _checkpoint_load()
    if cp:
        print(f"  [checkpoint] Run ID: {cp.get('run_id', '?')}")
        print(f"  [checkpoint] Phase:  {cp.get('phase', '?')}")
        print(f"  [checkpoint] Saved:  {cp.get('saved_at', '?')[:19]}")
        if cp.get("run_dir"):
            print(f"  [checkpoint] Run dir: {cp.get('run_dir')}")
        print()
    else:
        print("  [checkpoint] No checkpoint found. Resuming from USB/VM scan.")
        print()

    bootstrap_sh = _REPO_ROOT / "tools/livedev-bootstrap.sh"

    if not bootstrap_sh.exists():
        print("  [FAIL] tools/livedev-bootstrap.sh not found. Cannot resume.")
        return 1

    args = ["--resume"]
    if dry_run:
        args.append("--dry-run")
    if submit:
        args.append("--submit")

    print("  Running: bash tools/livedev-bootstrap.sh " + " ".join(args))
    print("  (This will scan for the USB, copy results, validate, and run submit dry-run.)")
    if submit:
        print("  -Submit requested: will open a real evidence PR (no auto-merge).")
    print()

    rc, stdout, stderr = _run(
        ["bash", str(bootstrap_sh)] + args, cwd=_REPO_ROOT, timeout=1800
    )
    if stdout.strip():
        print(stdout.strip()[-2000:])
    if rc != 0:
        print(f"  [FAIL] bootstrap.sh exited {rc}")
        if stderr.strip():
            print(f"     {stderr.strip()[-300:]}")
        return rc

    # SECURITY: after bootstrap returns, RELOAD the checkpoint rather than
    # overwriting it with stale data. bootstrap.sh's do_resume updates the
    # checkpoint with the correct run_dir (persistent, not /tmp) and
    # inventory_path. If we overwrote it with the old `cp` data we captured
    # before calling bootstrap, we would lose bootstrap's updates.
    cp_after = _checkpoint_load()
    if cp_after:
        print()
        print(f"  [checkpoint] Updated by bootstrap:")
        print(f"    Phase:    {cp_after.get('phase', '?')}")
        print(f"    Run dir:  {cp_after.get('run_dir', '?')}")
    return rc


# --- Run-VM (deterministic QEMU-driven livedev cycle) -----------------------


def cmd_run_vm(ns) -> int:
    """Run a deterministic QEMU-driven livedev cycle.

    This is the new primary path for livedev testing. It:
      1. Builds or locates the disk image.
      2. Creates persistent test-intent state.
      3. Launches QEMU with stable options.
      4. Waits for explicit guest markers (BOOT_READY, TEST_START,
         TEST_PASS/FAIL, SHUTDOWN) — NOT arbitrary sleeps.
      5. Detects failure patterns (panic, emergency mode, root prompt).
      6. Collects artifacts (console.log, summary.json, dmesg.log, etc.).
      7. Submits results according to --submit.
      8. Exits with the test exit code or an infrastructure-failure code.

    Replaces the old manual flow:
      bash tools/livedev-bootstrap.sh --auto   # prepare USB, print reboot instrs
      <user reboots host machine to boot USB>
      <user runs tests>
      <user reboots back>
      bash tools/livedev-bootstrap.sh --resume

    The old --auto/--resume flow is preserved for real-hardware USB testing;
    --run-vm is for QEMU-based testing where the host can drive the guest
    directly through the serial console.
    """
    print("=" * 60)
    print("  Rush LiveDev - Run-VM (deterministic QEMU cycle)")
    print("=" * 60)
    print()

    image_path = ns.image
    if not Path(image_path).is_absolute():
        image_path = str(_REPO_ROOT / image_path)
    if not Path(image_path).exists():
        print(f"  [FAIL] disk image not found: {image_path}")
        print()
        print("  Build it first:")
        print("    sudo bash tools/build-mkosi-image.sh --edition livedev")
        return 1

    # Hand off to the orchestrator. We exec it directly so its stdio is ours.
    orch = _TOOLS_DIR / "rush-livedev-orchestrator"
    cmd = [
        "python3", str(orch),
        "--image", image_path,
        "--suite", ns.suite,
        "--test-cmd", ns.test_cmd,
        "--submit", ns.submit_mode,
    ]
    if ns.run_id:
        cmd += ["--run-id", ns.run_id]
    if ns.debug:
        cmd += ["--debug"]
    if ns.ci:
        cmd += ["--ci"]
    cmd += [
        "--boot-timeout", str(ns.boot_timeout),
        "--test-start-timeout", str(ns.test_start_timeout),
        "--test-timeout", str(ns.test_timeout),
        "--shutdown-timeout", str(ns.shutdown_timeout),
    ]
    if ns.artifacts_dir:
        cmd += ["--artifacts-dir", ns.artifacts_dir]
    if ns.console_log:
        cmd += ["--console-log", ns.console_log]
    if ns.keep_vm:
        cmd += ["--keep-vm"]
    if ns.verbose:
        cmd += ["--verbose"]
    cmd += [
        "--qemu-memory", ns.qemu_memory,
        "--qemu-cpus", str(ns.qemu_cpus),
        "--qemu-accel", ns.qemu_accel,
    ]
    if ns.qemu_firmware:
        cmd += ["--qemu-firmware", ns.qemu_firmware]
    cmd += ["--inject-state", ns.inject_state]
    if ns.virtiofs_share:
        cmd += ["--virtiofs-share", ns.virtiofs_share]

    print(f"  Launching: {' '.join(cmd)}")
    print()
    try:
        return subprocess.call(cmd, cwd=str(_REPO_ROOT))
    except FileNotFoundError:
        print(f"  [FAIL] orchestrator not found: {orch}")
        return 1


# --- CLI --------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="livedev-next",
        description="Single entrypoint for Rush LiveDev operations.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--auto", action="store_true",
        help="Run the full pipeline: plan -> run -> validate -> submit (dry-run). "
             "With --dry-run, shows the pipeline without writing USB.",
    )
    group.add_argument("--mock", action="store_true", help="Run mock tests (no hardware, no network).")
    group.add_argument("--plan", action="store_true", help="Generate a benchmark plan.")
    group.add_argument("--run", type=str, metavar="PLAN_PATH", help="Execute a plan.")
    group.add_argument(
        "--submit", type=str, metavar="RUN_DIR",
        help="Submit evidence from a run directory.",
    )
    group.add_argument(
        "--prepare-usb", action="store_true",
        help="Prepare a USB using the current testOS boot backend.",
    )
    group.add_argument(
        "--resume", action="store_true",
        help="Resume after reboot: copy results, validate, submit dry-run.",
    )
    group.add_argument(
        "--run-vm", action="store_true",
        help="Run a deterministic QEMU-driven livedev cycle: build state, "
             "launch VM, wait for markers, collect artifacts, submit. "
             "Replaces the manual reboot-to-test-resume flow.",
    )
    parser.add_argument(
        "--dry-run", action="store_true", default=False,
        help="Dry-run mode for --auto (show pipeline, do not write USB) or --submit.",
    )
    parser.add_argument(
        "--submit-real", action="store_true", default=False,
        help="Used with --resume: open a real evidence PR (no auto-merge).",
    )
    parser.add_argument(
        "--baseline-only", action="store_true", default=False,
        help="With --plan, forbid optid actuation and redact the repository path.",
    )
    # ── --run-vm flags ───────────────────────────────────────────────────
    parser.add_argument("--image", default="build/rush-linux-livedev.raw",
                        help="disk image to boot (default: build/rush-linux-livedev.raw)")
    parser.add_argument("--suite", default="default")
    parser.add_argument("--test-cmd", default="true",
                        help="shell command to run on the guest after reboot")
    parser.add_argument("--run-id", default="")
    parser.add_argument("--timeout", type=int, default=1800,
                        help="overall test execution timeout (seconds)")
    parser.add_argument("--boot-timeout", type=int, default=180)
    parser.add_argument("--test-start-timeout", type=int, default=60)
    parser.add_argument("--test-timeout", type=int, default=1800)
    parser.add_argument("--shutdown-timeout", type=int, default=60)
    parser.add_argument("--debug", action="store_true",
                        help="on failure, drop to an interactive shell on the guest")
    parser.add_argument("--ci", action="store_true",
                        help="CI mode: never interactive, always terminate by pass/fail/timeout")
    parser.add_argument("--submit-mode", default="local",
                        choices=["none", "local", "github", "http", "auto"],
                        help="submission mode for --run-vm (default: local)")
    parser.add_argument("--artifacts-dir", default="")
    parser.add_argument("--keep-vm", action="store_true",
                        help="do not terminate QEMU after the run (debugging)")
    parser.add_argument("--console-log", default="")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--qemu-memory", default="2G")
    parser.add_argument("--qemu-cpus", type=int, default=2)
    parser.add_argument("--qemu-accel", default="auto")
    parser.add_argument("--qemu-firmware", default="")
    parser.add_argument("--inject-state", default="copy-on-image",
                        choices=["copy-on-image", "virtiofs", "9p", "none"])
    parser.add_argument("--virtiofs-share", default="")
    ns = parser.parse_args(argv)

    if ns.auto:
        return cmd_auto(dry_run=ns.dry_run)
    if ns.mock:
        return cmd_mock()
    if ns.plan:
        return cmd_plan(baseline_only=ns.baseline_only, dry_run=ns.dry_run)
    if ns.run:
        return cmd_run(ns.run)
    if ns.submit:
        return cmd_submit(ns.submit, ns.dry_run)
    if ns.prepare_usb:
        return cmd_prepare_usb(dry_run=ns.dry_run)
    if ns.resume:
        return cmd_resume(dry_run=ns.dry_run, submit=ns.submit_real)
    if ns.run_vm:
        return cmd_run_vm(ns)
    return cmd_default()


if __name__ == "__main__":
    sys.exit(main())
