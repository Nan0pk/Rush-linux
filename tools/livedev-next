    cmd = [
        "python3", "tools/rush-autopilot", "run",
        "--plan", plan_path, "--run-dir", run_dir, "--fake",
    ]
    print(f"  Plan:    {plan_path}")
    print(f"  Run dir: {run_dir}")
    print(f"  Mode:    fake (safe - no real hardware)")
    print()
    print(f"  Running: {' '.join(cmd)}")
    print()

    rc, stdout, stderr = _run(cmd, cwd=_REPO_ROOT, timeout=300)
