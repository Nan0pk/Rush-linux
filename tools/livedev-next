# ── Checkpoint integration ──────────────────────────────────────────────────
# The checkpoint tool provides persistent resumable state across reboots.
# livedev-next saves a checkpoint at each phase transition so the operator
# can resume with a single generated command after reboot.
_CHECKPOINT_TOOL = _TOOLS_DIR / "rush-livedev-checkpoint.py"
_INVENTORY_TOOL = _TOOLS_DIR / "collect-hardware-inventory.py"


def _checkpoint_save(run_id: str, phase: str, run_dir: str = "",
                     plan_path: str = "", inventory_path: str = "",
                     branch: str = "", pr_url: str = "") -> None:
    """Save a checkpoint. Non-fatal if it fails (checkpoint is a convenience)."""
    if not _CHECKPOINT_TOOL.exists():
        return
    cmd = [
        PYTHON, str(_CHECKPOINT_TOOL), "save",
        "--run-id", run_id,
        "--phase", phase,
    ]
    if run_dir:
        cmd += ["--run-dir", run_dir]
    if plan_path:
        cmd += ["--plan-path", plan_path]
    if inventory_path:
        cmd += ["--inventory-path", inventory_path]
    if branch:
        cmd += ["--branch", branch]
    if pr_url:
        cmd += ["--pr-url", pr_url]
    try:
        subprocess.run(cmd, capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _checkpoint_load() -> dict | None:
    """Load the current checkpoint, or None if absent/unreadable."""
    if not _CHECKPOINT_TOOL.exists():
        return None
    try:
        r = subprocess.run(
            [PYTHON, str(_CHECKPOINT_TOOL), "load"],
            capture_output=True, text=True, timeout=5
        )
        if r.returncode == 0 and r.stdout.strip() != "null":
            return json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        pass
    return None


def _collect_hardware_inventory(run_dir: str) -> str:
    """Collect privacy-safe hardware inventory into run_dir.

    Returns the path to the written inventory file, or empty string on
    failure. The inventory is collected automatically as part of --auto
    so the evidence bundle includes the host's capabilities without the
    operator needing to run a separate command.

    Privacy: the collector has a built-in privacy scanner that refuses
    to write output if any redactable pattern (serials, MACs, UUIDs,
    IPs, hostnames, SSIDs, home paths) is detected.
    """
    if not _INVENTORY_TOOL.exists():
        return ""
    inventory_path = str(Path(run_dir) / "hardware-inventory.json")
    try:
        r = subprocess.run(
            [PYTHON, str(_INVENTORY_TOOL), "--output", inventory_path],
            capture_output=True, text=True, timeout=30
        )
        if r.returncode == 0 and Path(inventory_path).exists():
            return inventory_path
        # Privacy violation (exit 2) or other failure — log but don't crash.
        if r.returncode == 2:
            print(f"  [WARN] Hardware inventory collection refused (privacy violation):")
            for line in r.stderr.strip().splitlines()[:3]:
                print(f"         {line}")
        else:
            print(f"  [WARN] Hardware inventory collection failed (exit {r.returncode})")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""

