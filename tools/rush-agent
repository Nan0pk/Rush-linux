#!/usr/bin/env python3
"""
rush-agent — AI-assisted development CLI for Rush LiveDev.

Provides controlled AI-assisted development through a CLI harness. The AI
never executes shell commands, never merges PRs, never modifies release
truth. The mock provider is deterministic and requires no network.

Usage:
  tools/rush-agent context --run-dir <path> --output <path> [--repo <path>] [--source-file <path>...]
  tools/rush-agent validate-redaction --context <path>
  tools/rush-agent diagnose --context <path> --provider mock
  tools/rush-agent propose-patch --context <path> --provider mock
  tools/rush-agent validate-patch --patch <path>

Exit codes:
  0 — success
  1 — validation failure
  2 — internal error
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_TOOLS_DIR = Path(__file__).resolve().parent
_ROOT = _TOOLS_DIR.parent
sys.path.insert(0, str(_TOOLS_DIR))
import rush_agent_lib as agent  # noqa: E402


def cmd_context(args: argparse.Namespace) -> int:
    """Build a redacted context bundle from a run directory."""
    run_dir = Path(args.run_dir).resolve()
    repo_root = Path(args.repo).resolve() if args.repo else _ROOT
    if not run_dir.exists():
        print(f"rush-agent: run-dir not found: {run_dir}", file=sys.stderr)
        return 2

    source_files = [Path(sf) for sf in args.source_file] if args.source_file else None
    context = agent.build_context(run_dir, repo_root, source_files=source_files)

    context_dict = context.to_dict()
    output_text = json.dumps(context_dict, indent=2, sort_keys=True)

    if args.output:
        out_path = Path(args.output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(output_text + "\n")
        print(f"rush-agent: context written to {out_path}", file=sys.stderr)
    else:
        print(output_text)

    return 0


def cmd_validate_redaction(args: argparse.Namespace) -> int:
    """Validate that a context bundle has no unredacted secrets."""
    context_path = Path(args.context)
    if not context_path.exists():
        print(f"rush-agent: context file not found: {context_path}", file=sys.stderr)
        return 2

    try:
        context_dict = json.loads(context_path.read_text())
    except json.JSONDecodeError as e:
        print(f"rush-agent: context file is not valid JSON: {e}", file=sys.stderr)
        return 2

    ok, errors = agent.validate_redaction(context_dict)
    if ok:
        print("rush-agent: redaction OK — no unredacted secrets detected")
        return 0
    else:
        print(f"rush-agent: redaction FAILED — {len(errors)} unredacted secret(s):", file=sys.stderr)
        for e in errors:
            print(f"  ✗ {e}", file=sys.stderr)
        return 1


def cmd_diagnose(args: argparse.Namespace) -> int:
    """Produce a diagnosis from a context bundle."""
    context_path = Path(args.context)
    if not context_path.exists():
        print(f"rush-agent: context file not found: {context_path}", file=sys.stderr)
        return 2

    try:
        context_dict = json.loads(context_path.read_text())
    except json.JSONDecodeError as e:
        print(f"rush-agent: context file is not valid JSON: {e}", file=sys.stderr)
        return 2

    if args.provider == "mock":
        diagnosis = agent.mock_diagnose(context_dict)
    else:
        print(f"rush-agent: provider {args.provider!r} not implemented (only 'mock' is available)", file=sys.stderr)
        return 2

    print(json.dumps(diagnosis, indent=2, sort_keys=True))
    return 0


def cmd_propose_patch(args: argparse.Namespace) -> int:
    """Propose a patch from a context bundle."""
    context_path = Path(args.context)
    if not context_path.exists():
        print(f"rush-agent: context file not found: {context_path}", file=sys.stderr)
        return 2

    try:
        context_dict = json.loads(context_path.read_text())
    except json.JSONDecodeError as e:
        print(f"rush-agent: context file is not valid JSON: {e}", file=sys.stderr)
        return 2

    if args.provider == "mock":
        patch = agent.mock_propose_patch(context_dict)
    else:
        print(f"rush-agent: provider {args.provider!r} not implemented (only 'mock' is available)", file=sys.stderr)
        return 2

    print(json.dumps(patch, indent=2, sort_keys=True))
    return 0


def cmd_validate_patch(args: argparse.Namespace) -> int:
    """Validate a proposed patch."""
    patch_path = Path(args.patch)
    if not patch_path.exists():
        print(f"rush-agent: patch file not found: {patch_path}", file=sys.stderr)
        return 2

    try:
        patch = json.loads(patch_path.read_text())
    except json.JSONDecodeError as e:
        print(f"rush-agent: patch file is not valid JSON: {e}", file=sys.stderr)
        return 2

    result = agent.validate_patch(patch)
    if result.valid:
        print("rush-agent: patch OK")
        for w in result.warnings:
            print(f"  ⚠ {w}")
        return 0
    else:
        print(f"rush-agent: patch REJECTED — {len(result.errors)} error(s):", file=sys.stderr)
        for e in result.errors:
            print(f"  ✗ {e}", file=sys.stderr)
        for w in result.warnings:
            print(f"  ⚠ {w}", file=sys.stderr)
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="rush-agent",
        description="AI-assisted development CLI for Rush LiveDev.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_ctx = sub.add_parser("context", help="Build a redacted context bundle.")
    p_ctx.add_argument("--run-dir", required=True, type=str)
    p_ctx.add_argument("--output", type=str, default=None)
    p_ctx.add_argument("--repo", type=str, default=None)
    p_ctx.add_argument("--source-file", action="append", default=None)
    p_ctx.set_defaults(func=cmd_context)

    p_red = sub.add_parser("validate-redaction", help="Validate redaction in a context bundle.")
    p_red.add_argument("--context", required=True, type=str)
    p_red.set_defaults(func=cmd_validate_redaction)

    p_diag = sub.add_parser("diagnose", help="Produce a diagnosis.")
    p_diag.add_argument("--context", required=True, type=str)
    p_diag.add_argument("--provider", default="mock", choices=["mock", "http"])
    p_diag.set_defaults(func=cmd_diagnose)

    p_patch = sub.add_parser("propose-patch", help="Propose a patch.")
    p_patch.add_argument("--context", required=True, type=str)
    p_patch.add_argument("--provider", default="mock", choices=["mock", "http"])
    p_patch.set_defaults(func=cmd_propose_patch)

    p_val = sub.add_parser("validate-patch", help="Validate a proposed patch.")
    p_val.add_argument("--patch", required=True, type=str)
    p_val.set_defaults(func=cmd_validate_patch)

    ns = parser.parse_args(argv)
    return ns.func(ns)


if __name__ == "__main__":
    sys.exit(main())
