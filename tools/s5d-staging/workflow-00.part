name: S5D circuit-breaker builder and verifier

on:
  pull_request:
    branches: [main]
    types: [opened, reopened, synchronize]

permissions:
  contents: write
  actions: read

concurrency:
  group: s5d-builder-verifier-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  build:
    name: Build bounded S5D implementation
    if: >-
      github.event.pull_request.head.ref == 'work/20260804-s5d-circuit-breakers' &&
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    env:
      BASE_COMMIT: ba7c56ba606bc65d33f90de76361964971df9064
      HEAD_REF: ${{ github.event.pull_request.head.ref }}
    outputs:
      source_head: ${{ steps.publish.outputs.source_head }}
      staging_head: ${{ steps.bind.outputs.staging_head }}

    steps:
      - name: Check out staging branch
        uses: actions/checkout@v7
        with:
          ref: ${{ github.event.pull_request.head.ref }}
          fetch-depth: 0

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libdbus-1-dev pkg-config

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt

      - name: Cache Rust
        uses: Swatinem/rust-cache@v2

      - name: Bind immutable base and staging-only files
        id: bind
        run: |
          set -euo pipefail
          staging_head=$(git rev-parse HEAD)
          echo "staging_head=$staging_head" >> "$GITHUB_OUTPUT"
          git fetch origin main --force
          test "$(git rev-parse origin/main)" = "$BASE_COMMIT"
          git merge-base --is-ancestor "$BASE_COMMIT" "$staging_head"
          expected=$(mktemp)
          actual=$(mktemp)
          printf '%s\n' \
            '.github/workflows/agent-s5d-builder.yml' \
            'tools/agent-s5d-verify.py' \
            'tools/s5d-staging/architecture.part' \
            'tools/s5d-staging/corrections.py' \
            'tools/s5d-staging/workflow-00.part' \
            'tools/s5d-staging/workflow-01.part' \
            'tools/s5d-staging/workflow-02.part' \
            'tools/s5d-staging/workflow-03.part' \
            'tools/s5d-staging/patch-00.part' \
            'tools/s5d-staging/patch-01.part' \
            'tools/s5d-staging/patch-02.part' \
            'tools/s5d-staging/circuit-00.part' \
            'tools/s5d-staging/circuit-01.part' \
            'tools/s5d-staging/circuit-02.part' \
            'tools/s5d-staging/circuit-03.part' | sort > "$expected"
          git diff --name-only "$BASE_COMMIT"..HEAD | sort > "$actual"
          diff -u "$expected" "$actual"
          cat tools/s5d-staging/patch-00.part \
              tools/s5d-staging/patch-01.part \
              tools/s5d-staging/patch-02.part > /tmp/agent-s5d-patch.py
          python3 -m py_compile /tmp/agent-s5d-patch.py tools/agent-s5d-verify.py tools/s5d-staging/corrections.py
          bash tools/start-work.sh "S5D persistent domain circuit breakers"

      - name: Apply bounded implementation
        run: |
          python3 /tmp/agent-s5d-patch.py
          python3 tools/s5d-staging/corrections.py

      - name: Format, compile, lint, and execute S5D matrix
        run: |
          set -euo pipefail
          cargo fmt --all
          cargo fmt --all -- --check
          cargo check --workspace --all-targets --all-features
          cargo clippy --workspace --all-targets --all-features -- -D warnings

          python3 - <<'PY' > /tmp/s5d-tests.txt
          import re
          from pathlib import Path
          names = []
          for path in [
              Path('crates/optid/src/circuit_breaker.rs'),
              Path('crates/optid/src/args.rs'),
          ]:
              names.extend(re.findall(r'(?m)^\s*fn (s5d_[a-z0-9_]+)\(\)', path.read_text()))
          assert len(names) == 13, names
          assert len(set(names)) == 13, names
          print('\n'.join(sorted(names)))
          PY

          count=0
          while IFS= read -r short_name; do
            count=$((count + 1))
            listed=$(mktemp)
            cargo test -p optid --all-features --color never "$short_name" -- --list \
              2>&1 | tee "$listed"
            full_name=$(python3 - "$short_name" "$listed" <<'PY'
          import sys
          from pathlib import Path
          short = sys.argv[1]
          matches = []
          for line in Path(sys.argv[2]).read_text(errors='replace').splitlines():
              if line.endswith(': test'):
                  name = line[:-6]
                  if name == short or name.endswith('::' + short):
                      matches.append(name)
          if len(matches) != 1:
              raise SystemExit(f'{short}: expected one exact test, found {matches}')
          print(matches[0])
          PY
            )
            cargo test -p optid --all-features --color never "$full_name" -- \
              --exact --nocapture
          done < /tmp/s5d-tests.txt
          test "$count" -eq 13

          cargo test -p optid --all-features
          cargo test --workspace --all-features
          python3 tools/validate-current-work.py
          python3 tools/render-frontpage.py --check
          git diff --check
