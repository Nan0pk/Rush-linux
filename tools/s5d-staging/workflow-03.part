            result=$(systemctl show optid-capability-seal-test.service -p Result --value)
            [[ "$active" == inactive && "$result" == success ]] && break
            [[ "$active" == failed ]] && break
            sleep 1
          done
          sudo journalctl --sync
          sudo journalctl -u optid-capability-seal-test.service \
            --since "$proof_started" --no-pager -o cat | tee /tmp/s5d-status75.log
          test "$(systemctl show optid-capability-seal-test.service -p Result --value)" = success
          test "$(systemctl show optid-capability-seal-test.service -p ExecMainStatus --value)" = 0
          test "$(grep -cF 'Scheduled restart job, restart counter is at 1.' /tmp/s5d-status75.log)" -eq 1
          test "$(grep -cF 'recovery step completed:' /tmp/s5d-status75.log)" -eq 2
          test "$(grep -cF 'capability-sealing proof passed (8 checks)' /tmp/s5d-status75.log)" -eq 2

          sudo mkdir -p /run/systemd/system/optid-capability-seal-test.service.d
          sudo tee /run/systemd/system/optid-capability-seal-test.service.d/non75.conf >/dev/null <<'EOF'
          [Service]
          ExecStart=
          ExecStart=/bin/sh -c 'exit 1'
          EOF
          sudo systemctl daemon-reload
          sudo systemctl reset-failed optid-capability-seal-test.service || true
          failed_started=$(date --iso-8601=seconds)
          set +e
          sudo systemctl start optid-capability-seal-test.service
          set -e
          sleep 3
          sudo journalctl --sync
          sudo journalctl -u optid-capability-seal-test.service \
            --since "$failed_started" --no-pager -o cat | tee /tmp/s5d-non75.log
          test "$(systemctl show optid-capability-seal-test.service -p ExecMainStatus --value)" = 1
          test "$(systemctl show optid-capability-seal-test.service -p NRestarts --value)" = 0
          ! grep -qF 'Scheduled restart job' /tmp/s5d-non75.log
          cat /tmp/s5d-status75.log /tmp/s5d-non75.log >> "$PROOF_LOG"
          echo "live_recovery_capability_supervisor_proof=pass"

      - name: Upload immutable candidate-verification evidence
        uses: actions/upload-artifact@v7
        with:
          name: ${{ env.ARTIFACT_NAME }}
          path: ${{ env.PROOF_LOG }}
          if-no-files-found: error
          retention-days: 30

      - name: Resolve workflow and artifact provenance
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          job_id=$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/jobs" \
            --jq '.jobs[] | select(.name == "Independently verify shared surfaces and S5D candidate") | .id')
          artifact=""
          for _ in $(seq 1 20); do
            artifact=$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/artifacts" \
              --jq ".artifacts[] | select(.name == \"$ARTIFACT_NAME\")")
            [[ -n "$artifact" ]] && break
            sleep 2
          done
          test -n "$job_id"
          test -n "$artifact"
          test "$(jq -r '.expired' <<<"$artifact")" = false
          test "$(jq -r '.digest' <<<"$artifact")" != null
          echo "WORKFLOW_JOB=$job_id" >> "$GITHUB_ENV"
          echo "ARTIFACT_ID=$(jq -r '.id' <<<"$artifact")" >> "$GITHUB_ENV"
          echo "ARTIFACT_DIGEST=$(jq -r '.digest' <<<"$artifact")" >> "$GITHUB_ENV"
          echo "ARTIFACT_SIZE=$(jq -r '.size_in_bytes' <<<"$artifact")" >> "$GITHUB_ENV"
          echo "ARTIFACT_EXPIRES=$(jq -r '.expires_at' <<<"$artifact")" >> "$GITHUB_ENV"

      - name: Publish refreshed receipts and S5D candidate truth
        env:
          WORKFLOW_RUN: ${{ github.run_id }}
          WORKFLOW_ATTEMPT: ${{ github.run_attempt }}
        run: |
          set -euo pipefail
          python3 /tmp/agent-s5d-verify.py
          python3 tools/render-frontpage.py --write
          python3 tools/validate-current-work.py
          python3 tools/validate-optid-packages.py --base origin/main
          python3 tools/render-frontpage.py --check
          git diff --check
          bash tools/finish-work.sh --dry-run

          python3 - <<'PY'
          import os
          import subprocess
          files = set(subprocess.check_output(
              ['git', 'diff', '--name-only', os.environ['SOURCE_HEAD']], text=True
          ).splitlines())
          required = {
              'docs/plans/optid-package-status.toml',
              'docs/plans/optid-verification/f1.toml',
              'docs/plans/optid-verification/f2.toml',
              'docs/plans/optid-verification/f3.toml',
              'docs/plans/optid-verification/f4.toml',
              'docs/plans/optid-verification/s2d.toml',
              'docs/plans/optid-verification/s3d.toml',
              'docs/plans/optid-verification/s4d.toml',
          }
          allowed = required | {'README.md'}
          assert required <= files <= allowed, files
          PY

          git config user.name rush-s5d-independent-verifier
          git config user.email rush-s5d-independent-verifier@users.noreply.github.com
          git add -A
          git commit -m 'verify(optid): recertify shared surfaces and record S5D candidate'
          git push origin "HEAD:$HEAD_REF"
