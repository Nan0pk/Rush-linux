
      - name: Publish immutable implementation source
        id: publish
        run: |
          set -euo pipefail
          rm -rf tools/s5d-staging
          rm tools/agent-s5d-verify.py .github/workflows/agent-s5d-builder.yml
          python3 - <<'PY'
          import os
          import subprocess
          expected = {
              'config/optid/policy.toml',
              'crates/optid/src/args.rs',
              'crates/optid/src/circuit_breaker.rs',
              'crates/optid/src/main.rs',
              'crates/optid/src/policy.rs',
              'crates/optid/src/reconciler/apply.rs',
              'docs/architecture/optid-s5d-circuit-breakers.md',
          }
          files = set(subprocess.check_output(
              ['git', 'diff', '--name-only', os.environ['BASE_COMMIT']],
              text=True,
          ).splitlines())
          assert files == expected, files
          PY
          git diff --check
          git config user.name rush-s5d-builder
          git config user.email rush-s5d-builder@users.noreply.github.com
          git add -A
          git commit -m 'feat(optid): add persistent domain circuit breakers'
          source_head=$(git rev-parse HEAD)
          echo "source_head=$source_head" >> "$GITHUB_OUTPUT"
          git push origin "HEAD:$HEAD_REF"

  verify:
    name: Independently verify shared surfaces and S5D candidate
    needs: build
    runs-on: ubuntu-24.04
    timeout-minutes: 75
    env:
      BASE_COMMIT: ba7c56ba606bc65d33f90de76361964971df9064
      SOURCE_HEAD: ${{ needs.build.outputs.source_head }}
      STAGING_HEAD: ${{ needs.build.outputs.staging_head }}
      HEAD_REF: ${{ github.event.pull_request.head.ref }}
      PROOF_LOG: /tmp/s5d-candidate-verification.log
      ARTIFACT_NAME: s5d-candidate-verification-${{ github.run_id }}

    steps:
      - name: Check out immutable implementation source
        uses: actions/checkout@v7
        with:
          ref: ${{ needs.build.outputs.source_head }}
          fetch-depth: 0

      - name: Recover verifier publisher from staging commit
        run: |
          set -euo pipefail
          git show "$STAGING_HEAD:tools/agent-s5d-verify.py" \
            > /tmp/agent-s5d-verify.py
          python3 -m py_compile /tmp/agent-s5d-verify.py

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libdbus-1-dev pkg-config

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt

      - name: Cache Rust
        uses: Swatinem/rust-cache@v2

      - name: Bind source and derive affected completed packages
        run: |
          set -euo pipefail
          exec > >(tee -a "$PROOF_LOG") 2>&1
          test "$(git rev-parse HEAD)" = "$SOURCE_HEAD"
          git fetch origin main --force
          test "$(git rev-parse origin/main)" = "$BASE_COMMIT"
          git merge-base --is-ancestor "$BASE_COMMIT" "$SOURCE_HEAD"
          python3 - <<'PY'
          import subprocess
          import tomllib
          from pathlib import Path

          base = 'ba7c56ba606bc65d33f90de76361964971df9064'
          source = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
          changed = set(subprocess.check_output(
              ['git', 'diff', '--name-only', base, source], text=True
          ).splitlines())
          expected_files = {
              'config/optid/policy.toml',
              'crates/optid/src/args.rs',
              'crates/optid/src/circuit_breaker.rs',
              'crates/optid/src/main.rs',
              'crates/optid/src/policy.rs',
              'crates/optid/src/reconciler/apply.rs',
              'docs/architecture/optid-s5d-circuit-breakers.md',
          }
          assert changed == expected_files, changed
          ledger = tomllib.loads(Path('docs/plans/optid-package-status.toml').read_text())
          affected = []
          for package in ledger['package']:
              if package.get('status') != 'completed':
                  continue
              proof = set()
              for field in ('runtime_entrypoints', 'integration_tests', 'completion_evidence'):
                  proof.update(package.get(field, []))
              if proof & changed:
                  affected.append(package['id'])
          expected = ['F1', 'F2', 'F3', 'F4', 'S2D', 'S3D', 'S4D']
          assert affected == expected, affected
          Path('/tmp/s5d-affected-packages.txt').write_text('\n'.join(affected) + '\n')
          print('affected_completed_packages=' + ','.join(affected))
          PY
          python3 tools/validate-current-work.py
          python3 tools/validate-optid-packages.py
          python3 tools/render-frontpage.py --check
          git diff --check

      - name: Run every affected and S5D acceptance test
        run: |
          set -euo pipefail
          exec > >(tee -a "$PROOF_LOG") 2>&1
          cargo fmt --all -- --check
          cargo check --workspace --all-targets --all-features
          cargo clippy --workspace --all-targets --all-features -- -D warnings

          python3 - <<'PY' > /tmp/s5d-verifier-tests.tsv
          import re
          import tomllib
          from pathlib import Path
          ledger = tomllib.loads(Path('docs/plans/optid-package-status.toml').read_text())
