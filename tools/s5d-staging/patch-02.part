    """    #[test]
    fn s5d_clear_commands_are_one_shot_and_mutually_exclusive() {
        let domain = Args::parse([
            \"--clear-circuit-domain\".to_string(),
            \"runtime_pm\".to_string(),
        ])
        .expect(\"parse domain clear\");
        assert_eq!(domain.clear_circuit_domain.as_deref(), Some(\"runtime_pm\"));
        assert!(!domain.clear_all_circuits);

        let all = Args::parse([\"--clear-all-circuits\".to_string()])
            .expect(\"parse global clear\");
        assert!(all.clear_all_circuits);

        let conflict = Args::parse([
            \"--clear-all-circuits\".to_string(),
            \"--clear-circuit-domain\".to_string(),
            \"runtime_pm\".to_string(),
        ])
        .expect_err(\"clear forms must conflict\");
        assert!(conflict.contains(\"mutually exclusive\"));

        let apply = Args::parse([
            \"--apply\".to_string(),
            \"--clear-all-circuits\".to_string(),
        ])
        .expect_err(\"clear cannot actuate\");
        assert!(apply.contains(\"cannot be combined\"));
    }

    #[test]
    fn version_flag_is_recognized() {""",
