#!/usr/bin/env python3
"""
rush-exec — guarded command runner for the Rush LiveDev capture substrate.

Runs a command, captures its full metadata (argv, cwd, timestamps, exit code,
stdout, stderr, env, redaction status, payload hash), and appends a
tamper-evident event + command-log entry to the run directory.

Usage:
  tools/rush-exec --run-dir <path> [--timeout <sec>] [--cwd <path>] [--] <argv...>

Example:
  tools/rush-exec --run-dir /tmp/rush-run -- cargo test --workspace

The command is a typed argv array — NO shell string interpolation. The first
argv element must be an executable name or path; it must not be "sh" or "bash"
with a "-c" flag (the caller should construct the argv explicitly).

Run directory layout (managed by rush-capture; rush-exec appends to it):
  <run-dir>/
    events.jsonl           — tamper-evident event chain (rush-exec appends)
    command-log.jsonl      — per-command execution records (rush-exec appends)
    stdout/<seq>.txt       — stdout of command <seq>
    stderr/<seq>.txt       — stderr of command <seq>

Exit code: the exit code of the wrapped command (or 124 on timeout, matching
GNU timeout). On internal error (e.g., cannot write to run-dir), exits 2.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

# Import the shared library. Since this script lives in tools/, the import
# works when run as `python3 tools/rush-exec` or `tools/rush-exec` directly.
sys.path.insert(0, str(Path(__file__).resolve().parent))
import rush_capture_lib as lib  # noqa: E402


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="rush-exec",
        description="Guarded command runner for the Rush LiveDev capture substrate.",
        add_help=False,
    )
    parser.add_argument(
        "--run-dir",
        required=True,
        type=Path,
        help="Path to the capture run directory (created if it does not exist).",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=None,
        help="Kill the command after this many seconds. Exit code 124 on timeout.",
    )
    parser.add_argument(
        "--cwd",
        type=Path,
        default=None,
        help="Working directory for the command (default: current dir).",
    )
    parser.add_argument(
        "--no-redact",
        action="store_true",
        default=False,
        help="Disable redaction. DANGEROUS — only for trusted test fixtures.",
    )
    parser.add_argument(
        "-h",
        "--help",
        action="store_true",
        default=False,
        help="Show this help message.",
    )
    # Everything after "--" is the command to run.
    if "--" in argv:
        sep = argv.index("--")
        our_args = argv[:sep]
        cmd_args = argv[sep + 1 :]
    else:
        our_args = argv
        cmd_args = []

    ns = parser.parse_args(our_args)
    ns.cmd_args = cmd_args
    return ns


def validate_command(argv: list[str]) -> tuple[bool, str]:
    """Reject shell-string invocations. Returns (ok, error_message)."""
    if not argv:
        return False, "no command specified (use -- <argv...>)"
    exe = argv[0]
    # Reject "sh -c ..." and "bash -c ..." — the caller must construct the
    # argv explicitly. This is the same discipline as optid's guarded_write.
    if exe in ("sh", "bash", "zsh", "dash", "fish") and len(argv) >= 2 and argv[1] == "-c":
        return False, (
            f"refusing to run '{exe} -c \"...\"' — rush-exec requires a typed argv "
            f"array, not a shell string. Construct the argv explicitly."
        )
    return True, ""


def run_command(
    argv: list[str],
    cwd: Path | None,
    timeout: float | None,
) -> tuple[int, bytes, bytes, bool, int]:
    """Run the command. Returns (exit_code, stdout, stderr, timed_out, duration_ms)."""
    start_ms = lib.now_unix_ms()
    try:
        proc = subprocess.run(
            argv,
            cwd=str(cwd) if cwd else None,
            capture_output=True,
            timeout=timeout,
        )
        end_ms = lib.now_unix_ms()
        return (
            proc.returncode,
            proc.stdout,
            proc.stderr,
            False,
            lib.duration_ms(start_ms, end_ms),
        )
    except subprocess.TimeoutExpired as e:
        end_ms = lib.now_unix_ms()
        stdout = e.stdout or b""
        stderr = e.stderr or b""
        if isinstance(stdout, str):
            stdout = stdout.encode("utf-8")
        if isinstance(stderr, str):
            stderr = stderr.encode("utf-8")
        stderr += f"\n[rush-exec] timed out after {timeout}s\n".encode("utf-8")
        return (124, stdout, stderr, True, lib.duration_ms(start_ms, end_ms))
    except FileNotFoundError as e:
        # Command not found — return exit code 127 (matching shell convention).
        end_ms = lib.now_unix_ms()
        stderr = f"[rush-exec] command not found: {e.filename}\n".encode("utf-8")
        return (127, b"", stderr, False, lib.duration_ms(start_ms, end_ms))
    except PermissionError as e:
        # Command not executable — return exit code 126 (matching shell convention).
        end_ms = lib.now_unix_ms()
        stderr = f"[rush-exec] permission denied: {e.filename}\n".encode("utf-8")
        return (126, b"", stderr, False, lib.duration_ms(start_ms, end_ms))


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    ns = parse_args(argv)
    if ns.help:
        print(__doc__)
        return 0
    if not ns.cmd_args:
        print("rush-exec: no command specified (use -- <argv...>)", file=sys.stderr)
        return 2

    ok, err = validate_command(ns.cmd_args)
    if not ok:
        print(f"rush-exec: {err}", file=sys.stderr)
        return 2

    # Ensure the run directory exists (rush-capture start may not have been
    # called yet; rush-exec is self-sufficient).
    lib.init_run_dir(ns.run_dir)

    # Run the command.
    exit_code, stdout_bytes, stderr_bytes, timed_out, duration_ms = run_command(
        ns.cmd_args, ns.cwd, ns.timeout
    )

    # Decode output (best-effort; replace undecodable bytes).
    stdout_text = stdout_bytes.decode("utf-8", errors="replace")
    stderr_text = stderr_bytes.decode("utf-8", errors="replace")

    # Redact (unless --no-redact).
    redaction_report = lib.RedactionReport()
    if ns.no_redact:
        stdout_redacted = stdout_text
        stderr_redacted = stderr_text
        env_redacted = dict(os.environ)
        redaction_status = "disabled"
    else:
        stdout_redacted = lib.redact(stdout_text, redaction_report)
        stderr_redacted = lib.redact(stderr_text, redaction_report)
        env_redacted = lib.redact_env(dict(os.environ), redaction_report)
        redaction_status = "enabled"

    # Compute payload hashes (over the REDACTED output, so the hash is stable
    # across reruns even if the underlying secrets rotate).
    stdout_sha256 = lib.sha256_str(stdout_redacted)
    stderr_sha256 = lib.sha256_str(stderr_redacted)

    # Write stdout/stderr files to the run directory.
    seq = lib.next_seq(ns.run_dir / "events.jsonl")
    stdout_path = ns.run_dir / "stdout" / f"{seq}.txt"
    stderr_path = ns.run_dir / "stderr" / f"{seq}.txt"
    stdout_path.parent.mkdir(parents=True, exist_ok=True)
    stderr_path.parent.mkdir(parents=True, exist_ok=True)
    stdout_path.write_text(stdout_redacted, encoding="utf-8")
    stderr_path.write_text(stderr_redacted, encoding="utf-8")

    # Build the command-log entry.
    started_at = lib._now_iso()  # not perfectly accurate (post-run), but close
    # Recompute start time from duration for better accuracy.
    end_unix_ms = lib.now_unix_ms()
    start_unix_ms = end_unix_ms - duration_ms
    from datetime import datetime, timezone

    started_at = datetime.fromtimestamp(start_unix_ms / 1000, tz=timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    finished_at = datetime.fromtimestamp(end_unix_ms / 1000, tz=timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )

    command_log_entry: dict = {
        "schema_version": lib.SCHEMA_VERSION,
        "seq": seq,
        "argv": ns.cmd_args,
        "cwd": str(ns.cwd) if ns.cwd else str(Path.cwd()),
        "started_at": started_at,
        "finished_at": finished_at,
        "duration_ms": duration_ms,
        "exit_code": exit_code,
        "timed_out": timed_out,
        "timeout_sec": ns.timeout,
        "stdout_path": str(stdout_path.relative_to(ns.run_dir)),
        "stderr_path": str(stderr_path.relative_to(ns.run_dir)),
        "stdout_sha256": stdout_sha256,
        "stderr_sha256": stderr_sha256,
        "stdout_snippet": lib.snippet(stdout_redacted, 4096),
        "stderr_snippet": lib.snippet(stderr_redacted, 4096),
        "env_redacted": {
            k: env_redacted[k]
            for k in sorted(env_redacted)
            # Only record non-secret env var names + the redacted secret markers.
        },
        "redaction_status": redaction_status,
        "redaction_counts": redaction_report.counts,
        "payload_sha256": lib.sha256_str(
            stdout_sha256 + stderr_sha256 + " ".join(ns.cmd_args)
        ),
    }
    lib.append_jsonl(ns.run_dir / "command-log.jsonl", command_log_entry)

    # Append a tamper-evident event for this command.
    prev_sha = lib.last_event_sha256(ns.run_dir / "events.jsonl")
    event = lib.make_event(
        seq=seq,
        kind="command",
        payload={
            "argv": ns.cmd_args,
            "exit_code": exit_code,
            "duration_ms": duration_ms,
            "timed_out": timed_out,
            "stdout_sha256": stdout_sha256,
            "stderr_sha256": stderr_sha256,
        },
        prev_event_sha256=prev_sha,
    )
    lib.append_jsonl(ns.run_dir / "events.jsonl", event)

    # Print a one-line summary to stderr (stdout is reserved for the wrapped
    # command's output when it's piped; but since we capture stdout, we print
    # the summary to stderr so the operator sees it).
    status = "TIMEOUT" if timed_out else ("OK" if exit_code == 0 else f"EXIT={exit_code}")
    print(
        f"rush-exec: {status} duration={duration_ms}ms exit_code={exit_code} "
        f"stdout={stdout_sha256[:12]}… stderr={stderr_sha256[:12]}… "
        f"redactions={sum(redaction_report.counts.values())}",
        file=sys.stderr,
    )

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
