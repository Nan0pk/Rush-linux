#!/usr/bin/env python3
"""
rush-livedev-orchestrator — host-side state machine for livedev.

This is the deterministic replacement for the old "tell the user to reboot
and run --resume" flow. The host orchestrator:

  1. Generates a run_id.
  2. Prepares the artifacts directory.
  3. Creates the persistent test-intent state file.
  4. Injects the state file into the guest's /RUSH-DATA (via a writable
     overlay on the disk image, or via a virtiofs/9p share, or by writing
     directly to the mounted image — whichever the operator chose).
  5. Launches QEMU with stable options and serial console capture.
  6. Waits for explicit markers (BOOT_READY, TEST_START, TEST_PASS,
     TEST_FAIL, SHUTDOWN) — NOT arbitrary sleeps.
  7. Detects failure patterns (panic, emergency mode, login prompt,
     root shell) and fails the run immediately.
  8. Collects artifacts from the guest (via the same share or by
     re-mounting the image after shutdown).
  9. Writes summary.json + metadata.json.
 10. Optionally submits results (local bundle / GitHub / HTTP).
 11. Exits with the test exit code or an infrastructure-failure code.

Exit codes:
    0   — test passed
    1   — test failed (nonzero exit from test command)
    2   — infrastructure failure (QEMU missing, image missing, etc.)
    3   — boot timeout
    4   — test-start timeout (BOOT_READY seen but no TEST_START)
    5   — test-execution timeout (TEST_START seen but no terminal marker)
    6   — shutdown timeout (terminal marker seen but QEMU did not exit)
    7   — unexpected guest failure (root prompt, panic, emergency mode)
    8   — state error / invalid intent
   70  — generic infrastructure error
"""

from __future__ import annotations

