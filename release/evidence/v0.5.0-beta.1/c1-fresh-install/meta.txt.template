# Fill in and rename to meta.txt before committing.
date=<RFC3339 e.g. 2026-06-21T10:00:00+05:00>
host=<build host description, e.g. fedora-44-victus>
kernel=<output of `uname -r`>
cpu=<output of `lscpu | grep 'Model name:'`>
git_commit=<short sha being verified, `git rev-parse --short HEAD`>
mkosi_version=<output of `mkosi --version`>
qemu_version=<output of `qemu-system-x86_64 --version | head -1`>
systemd_repart_version=<output of `systemd-repart --version | head -1`>
image_path=build/rush-linux.raw
image_sha256=<output of `sha256sum build/rush-linux.raw`>
edition=server

