# Static package-set check — server edition has no desktop dependency
# Date: 2026-06-22T10:02:21Z   Commit: 85e5544

# Declared package set = base (mkosi.conf) + server profile, EXCLUDING comment lines.
$ cat mkosi/mkosi.conf mkosi/mkosi.profiles/server/mkosi.conf | grep -v "^\s*#" 

[Distribution]
Distribution=arch

[Output]
Format=disk
ImageId=rush-linux
OutputDirectory=../build

[Content]
Bootable=yes
Packages=
    base
    linux
    systemd-sysvcompat
    systemd-boot
    ukify
    zram-generator
    nftables
    dbus
    bash
Autologin=yes
KernelCommandLine=
    systemd.unified_cgroup_hierarchy=1
    cgroup_no_v1=all
    psi=1
    zswap.enabled=1
    rw
    console=ttyS0,115200
    systemd.firstboot=no
    quiet
    loglevel=3

[Output]
ImageId=rush-linux-server

[Content]
Packages=

# Search declared (non-comment) lines for desktop components:
$ ... | grep -Eiw "plasma|wayland|pipewire|xorg|x11|gnome|kde|sway|gdm|sddm"
(no matches)
RESULT: PASS — no desktop package in the server edition's declared package set
