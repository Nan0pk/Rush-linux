# Fill in and rename to meta.txt before committing.
date=<RFC3339>
host=<build host>
kernel=<uname -r>
git_commit=<short sha>
mkosi_version=<mkosi version>
edition=server

# Acceptance commands (run all three; pipe each into transcript.log via `tee -a`):
#
# 1. Build the server image:
#      sudo bash tools/build-mkosi-image.sh --edition server
#
# 2. Enumerate installed packages in the produced image and prove none of the
#    desktop-class packages are present. Replace <ROOT_MOUNT> with the path
#    where you mount build/rush-linux.raw partition 2 (root):
#
#      pacman --sysroot <ROOT_MOUNT> -Qq | sort > packages.txt
#      ! grep -E -i '^(xorg|xwayland|wayland|pipewire|plasma|gnome|kde|gdm|sddm|gnome-shell|mutter|kwin|gtk[34]|qt[56]-base)' packages.txt
#
# 3. Show the matching mkosi profile that excludes desktop packages:
#      cat mkosi/mkosi.profiles/server/mkosi.conf
