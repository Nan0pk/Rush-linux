# Optional PREEMPT_RT kernel fragment.
# This is a specialist kernel package, not the universal default.

CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_IRQ_FORCED_THREADING=y

