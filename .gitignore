# Rust build artifacts.
# Unanchored so nested target/ directories are covered too: crates that are
# excluded from the workspace (see the `exclude` list in the root Cargo.toml)
# build into their own crates/<name>/target/, which a leading-slash rule misses.
target/
# Lockfiles generated under workspace-excluded crates. The root /Cargo.lock
# stays tracked; only excluded crates resolve their own.
/crates/*/Cargo.lock

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Evidence artifacts (large, machine-specific binaries)
release/evidence/host-bench/*/artifacts/
release/evidence/host-bench/*/bundle.tar.gz
# But keep transcripts and metadata (the actual proof)
!release/evidence/**/*.log
!release/evidence/**/meta.txt
!release/evidence/**/results.json
!release/evidence/**/NOTE.md

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build intermediates
*.o
*.d
*.so
*.a
*.pdb
*.rs.bk

# Temporary
/tmp-debs/
*.bak

# mkosi / testOS build artifacts (audit issue #11, 2026-07-21)
# mkosi produces large .raw disk images during rootfs / UKI / testOS builds.
# mdBook builds the rendered site into book/ — never commit the build output.
*.raw
/book/

# mkosi cache and output directories (kept narrow — only top-level, not
# anything matching the name deeper in the tree)
/.mkosi-cache/
/.mkosi-output/
/.mkosi.btrfs/

# Test signing keys — generated under build/test-signing/keys/ by
# tools/test-sign-updates.sh. Never commit private key material to the
# repository. The narrow pattern catches config/keys/*.private.pem and
# build/test-signing/keys/*.private.pem alike.
*.private.pem
*.private
config/keys/*.private.pem
