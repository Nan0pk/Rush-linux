<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/io/rushlinux/Optid">
  <interface name="io.rushlinux.Optid1">
    <method name="Status">
      <arg name="status" type="s" direction="out"/>
    </method>
    <method name="StatusJson">
      <arg name="status_json" type="s" direction="out"/>
    </method>
    <method name="Explain">
      <arg name="explanation" type="s" direction="out"/>
    </method>
    <method name="SetMode">
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="PinApplication">
      <arg name="app_id" type="s" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
    </method>
    <property name="Mode" type="s" access="read"/>
    <property name="Version" type="s" access="read"/>
    <signal name="Decision">
      <arg name="mode" type="s"/>
      <arg name="reason" type="s"/>
    </signal>
  </interface>
</node>

