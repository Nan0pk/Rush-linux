# Rush Linux — optid hardware hot-plug notifications (WP-N4 support).
#
# Drafted from docs/research/0006-hw-allowlist-db-design.md §1.5. On device
# add/remove, notify optid so it can (re)evaluate the §3 actuation rule —
# including the WP-N4 hardware allowlist gate — for the newly present device.
# This is the "push" path; optid also has a main-loop poll fallback, so the
# rule is an optimization, not a correctness requirement.
#
# The optid-udev shim forwards (action, syspath, modalias) to optid over D-Bus
# (org.rush.Optid.DeviceHotplug). The MODALIAS the kernel exports here is the
# same canonical HWID form the allowlist is keyed on (pci:…, usb:…).

ACTION=="add", SUBSYSTEM=="pci", RUN+="/usr/lib/optid/optid-udev add %p %E{MODALIAS}"
ACTION=="add", SUBSYSTEM=="usb", DEVTYPE=="usb_device", RUN+="/usr/lib/optid/optid-udev add %p %E{MODALIAS}"
ACTION=="add", SUBSYSTEM=="thunderbolt", RUN+="/usr/lib/optid/optid-udev add %p %E{MODALIAS}"
ACTION=="remove", SUBSYSTEM=="pci", RUN+="/usr/lib/optid/optid-udev remove %p"
ACTION=="remove", SUBSYSTEM=="usb", DEVTYPE=="usb_device", RUN+="/usr/lib/optid/optid-udev remove %p"
ACTION=="remove", SUBSYSTEM=="thunderbolt", RUN+="/usr/lib/optid/optid-udev remove %p"
