# Test-only unit for capability sealing and supervisor-managed cold restart.
#
# This unit is repository evidence and is not installed in the shipped image.
# Each start runs the recovery step before constructing a fresh capability table.
# The first successful sealed cycle exits 75, which forces a cold restart. The
# second cycle verifies recovery again, rebuilds and seals a new table, then exits
# successfully.

[Unit]
Description=optid capability sealing and cold-restart proof (test-only)
Documentation=https://github.com/Nan0pk/Rush-linux/blob/main/docs/architecture/optid-d2-amendment.md
ConditionPathExists=/run/optid-capability-seal-test-enabled
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
ExecStartPre=/usr/local/libexec/optid-capability-seal-test --recovery-step /run/optid-capability-seal-test/recovery.ready
ExecStart=/usr/local/libexec/optid-capability-seal-test --supervisor-cycle /run/optid-capability-seal-test/recovery.ready /run/optid-capability-seal-test/cycle.count

# Only the dedicated topology-rebuild status forces a restart.
Restart=no
RestartForceExitStatus=75
RestartSec=2s

# The cycle counter must survive the automatic restart, but not a normal stop.
RuntimeDirectory=optid-capability-seal-test
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

# Match the prototype's own irreversible no-new-privileges requirement.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/optid-capability-seal-test /tmp

[Install]
WantedBy=multi-user.target
