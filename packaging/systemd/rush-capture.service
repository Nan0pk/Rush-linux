[Unit]
Description=Rush LiveDev capture session manager
Documentation=docs/editions/livedev.md
After=multi-user.target rush-livedev-autostart.service
Wants=rush-livedev-autostart.service

[Service]
Type=oneshot
ExecStart=/usr/bin/rush-capture start --run-dir /RUSH-DATA/state/capture --repo-root /RUSH-DATA/repo
ExecStop=/usr/bin/rush-capture finish --run-dir /RUSH-DATA/state/capture
RemainAfterExit=yes
WorkingDirectory=/RUSH-DATA
Environment=RUSH_DATA=/RUSH-DATA

[Install]
WantedBy=multi-user.target
