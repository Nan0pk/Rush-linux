[Unit]
Description=Rush LiveDev autostart (safe countdown before autopilot)
Documentation=docs/editions/livedev.md
After=multi-user.target systemd-networkd.service
Before=rush-capture.service rush-autopilot.service
# Do NOT run the interactive countdown when a test is queued. The
# rush-livedev-test.service owns post-reboot test execution and has
# Conflicts=rush-livedev-autostart.service; this ConditionPathExists is
# belt-and-suspenders so an idle boot still gets the countdown.
ConditionPathExists=!/RUSH-DATA/state/livedev-state.json

[Service]
Type=oneshot
ExecStart=/usr/bin/rush-livedev-autostart
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=RUSH_DATA=/RUSH-DATA

[Install]
WantedBy=multi-user.target
