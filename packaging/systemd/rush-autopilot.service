[Unit]
Description=Rush LiveDev autopilot planner/runner
Documentation=docs/editions/livedev.md
After=rush-capture.service
Wants=rush-capture.service

[Service]
Type=oneshot
ExecStart=/usr/bin/rush-autopilot plan --auto --output /RUSH-DATA/state/plan.json --repo /RUSH-DATA/repo
RemainAfterExit=yes
WorkingDirectory=/RUSH-DATA/repo
Environment=RUSH_DATA=/RUSH-DATA

[Install]
WantedBy=multi-user.target
