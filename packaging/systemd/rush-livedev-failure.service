[Unit]
Description=Rush LiveDev failure handler (fail-closed, no root prompt)
Documentation=docs/editions/livedev.md
# Started ONLY by OnFailure=rush-livedev-failure.service in
# rush-livedev-test.service. Emits a TEST_FAIL marker and powers off so
# the host sees a deterministic terminal state — never a silent root prompt.

[Service]
Type=oneshot
# Read the run_id from the state file (best-effort), emit a TEST_FAIL marker
# on the console, then power off. We use sh -c so we can chain commands
# without inventing a second binary. jq is in the livedev package set.
ExecStart=/bin/sh -c 'RID=$(jq -r .run_id /RUSH-DATA/state/livedev-state.json 2>/dev/null || echo unknown); echo "RUSH_LIVEDEV_TEST_FAIL run_id=$RID exit_code=70"; sleep 1; systemctl poweroff || poweroff'
StandardOutput=journal+console
StandardError=journal+console
User=root
Restart=no
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
