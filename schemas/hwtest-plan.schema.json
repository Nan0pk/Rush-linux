{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nan0pk/Rush-linux/raw/main/schemas/hwtest-plan.schema.json",
  "title": "Hardware Test Plan",
  "description": "The benchmark plan that the hardware evidence certifies. Defines the workload, phases, metrics, sample count, and pass conditions.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_kind",
    "plan_name",
    "workload",
    "phases",
    "min_samples",
    "pass_conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "plan_kind": {
      "type": "string",
      "const": "hwtest-plan"
    },
    "plan_name": {
      "type": "string",
      "description": "Name of the benchmark plan (e.g. 'mixed-load-001')."
    },
    "workload": {
      "type": "string",
      "description": "The workload identifier (e.g. 'mixed-load-001' per docs/strategy/mixed-load-workload.md)."
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "duration_sec", "expected_class", "metrics"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Phase name (e.g. 'idle-warm', 'interactive', 'throughput', 'latency-critical', 'idle-cooldown')."
          },
          "duration_sec": {
            "type": "integer",
            "minimum": 1
          },
          "expected_class": {
            "type": "string",
            "enum": ["idle", "light", "interactive", "latency-critical", "throughput", "vm-guest"]
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "Metric name (e.g. 'input-latency-p95-ms', 'psi-cpu-avg10', 'pkg-watts')."
            }
          }
        }
      }
    },
    "min_samples": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum number of samples required per metric per phase. The validator rejects evidence with fewer samples."
    },
    "pass_conditions": {
      "type": "object",
      "required": ["criterion_2_responsiveness", "criterion_3_battery"],
      "additionalProperties": false,
      "properties": {
        "criterion_2_responsiveness": {
          "type": "object",
          "required": ["applies_to_slots", "description"],
          "additionalProperties": false,
          "properties": {
            "applies_to_slots": {
              "type": "array",
              "items": {"type": "string", "enum": ["desktop", "laptop"]}
            },
            "description": {
              "type": "string",
              "description": "Human-readable pass condition (e.g. 'median and p99 latency under optid --apply are LOWER than baseline by more than the CI')."
            }
          }
        },
        "criterion_3_battery": {
          "type": "object",
          "required": ["applies_to_slots", "description"],
          "additionalProperties": false,
          "properties": {
            "applies_to_slots": {
              "type": "array",
              "items": {"type": "string", "enum": ["desktop", "laptop"]}
            },
            "description": {
              "type": "string",
              "description": "Human-readable pass condition. Desktop slot is N/A (no battery)."
            }
          }
        }
      }
    }
  }
}
